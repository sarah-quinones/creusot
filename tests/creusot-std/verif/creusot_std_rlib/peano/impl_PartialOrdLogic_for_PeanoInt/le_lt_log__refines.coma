(* <peano::PeanoInt as logic::ord::PartialOrdLogic> *)

use creusot.int.UInt64

type t_PeanoInt = { f0: UInt64.t }

function le_log_PeanoInt [@inline:trivial] (self: t_PeanoInt) (o: t_PeanoInt) : bool = UInt64.le self.f0 o.f0

meta "rewrite_def" function le_log_PeanoInt

function lt_log_PeanoInt [@inline:trivial] (self: t_PeanoInt) (o: t_PeanoInt) : bool = UInt64.lt self.f0 o.f0

meta "rewrite_def" function lt_log_PeanoInt

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_PeanoInt, other: t_PeanoInt. forall result: (). le_log_PeanoInt self other
        = (lt_log_PeanoInt self other \/ self = other)
      -> le_log_PeanoInt self other = (lt_log_PeanoInt self other \/ self = other)
