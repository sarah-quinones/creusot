(* <std::collections::hash_set::Iter<'a, T> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt64
use set.Fset

type t_Iter_T

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_DeepModelTy

function view_Iter_T (self: t_Iter_T) : Fset.fset t_DeepModelTy

function postcondition_size_hint (self: ()) (args: t_Iter_T) (result: tup2_usize_Option_usize) : bool =
  let self'0 = args in UInt64.t'int result.f0 = Fset.cardinal (view_Iter_T self'0) /\ result.f1 = Some (result.f0)

meta "rewrite_def" function postcondition_size_hint

function inv_Iter_T (_1: t_Iter_T) : bool

function invariant_ref_Iter_T [@inline:trivial] (self: t_Iter_T) : bool = inv_Iter_T self

meta "rewrite_def" function invariant_ref_Iter_T

function inv_ref_Iter_T [@inline:trivial] (_1: t_Iter_T) : bool = invariant_ref_Iter_T _1

meta "rewrite_def" function inv_ref_Iter_T

let size_hint_Iter_T (self: t_Iter_T) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_Iter_T self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_Iter_T ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = Fset.cardinal (view_Iter_T self))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Iter_T, r: tup2_usize_Option_usize. postcondition_size_hint () self r
    -> postcondition_size_hint () self r /\ (forall result: (). r.f1 = Some (r.f0) -> r.f1 = Some (r.f0))
