(* <std::collections::hash_map::IterMut<'a, K, V> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt64
use int.Int

type t_IterMut_K_V

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_FMap_DeepModelTy_refmut_V

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

function len_DeepModelTy (self: t_FMap_DeepModelTy_refmut_V) : int

axiom len_DeepModelTy_spec:
  forall self: t_FMap_DeepModelTy_refmut_V [len_DeepModelTy self]. ge_log_Int (len_DeepModelTy self) 0

function view_IterMut_K_V (self: t_IterMut_K_V) : t_FMap_DeepModelTy_refmut_V

function postcondition_size_hint (self: ()) (args: t_IterMut_K_V) (result: tup2_usize_Option_usize) : bool =
  let self'0 = args in UInt64.t'int result.f0 = len_DeepModelTy (view_IterMut_K_V self'0)
  /\ result.f1 = Some (result.f0)

meta "rewrite_def" function postcondition_size_hint

function inv_IterMut_K_V (_1: t_IterMut_K_V) : bool

function invariant_ref_IterMut_K_V [@inline:trivial] (self: t_IterMut_K_V) : bool = inv_IterMut_K_V self

meta "rewrite_def" function invariant_ref_IterMut_K_V

function inv_ref_IterMut_K_V [@inline:trivial] (_1: t_IterMut_K_V) : bool = invariant_ref_IterMut_K_V _1

meta "rewrite_def" function inv_ref_IterMut_K_V

let size_hint_IterMut_K_V (self: t_IterMut_K_V) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_IterMut_K_V self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IterMut_K_V ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = len_DeepModelTy (view_IterMut_K_V self))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_IterMut_K_V

constant r : tup2_usize_Option_usize

function size_hint_exact_IterMut_K_V (self: t_IterMut_K_V) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_exact_IterMut_K_V: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_exact ensures] r.f1 = Some (r.f0))
