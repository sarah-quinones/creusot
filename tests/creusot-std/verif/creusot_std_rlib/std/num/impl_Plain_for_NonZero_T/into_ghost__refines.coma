(* <std::num::NonZero<T> as ghost::Plain> *)

type t_T

function view_T (self: t_T) : int

function view_NonZero_T [@inline:trivial] (self: t_T) : int = view_T self

meta "rewrite_def" function view_NonZero_T

function inv_T (_1: t_T) : bool

function invariant_NonZero_T (self: t_T) : bool = view_NonZero_T self <> 0 /\ inv_T self

function inv_NonZero_T [@inline:trivial] (_1: t_T) : bool = invariant_NonZero_T _1

meta "rewrite_def" function inv_NonZero_T

function invariant_Ghost_NonZero_T [@inline:trivial] (self: t_T) : bool = inv_NonZero_T self

meta "rewrite_def" function invariant_Ghost_NonZero_T

function inv_Ghost_NonZero_T [@inline:trivial] (_1: t_T) : bool = invariant_Ghost_NonZero_T _1

meta "rewrite_def" function inv_Ghost_NonZero_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: t_T. inv_NonZero_T snap
    -> inv_NonZero_T snap
    /\ (forall result: t_T. inv_Ghost_NonZero_T result /\ result = snap -> inv_Ghost_NonZero_T result /\ result = snap)
