(* <usize as ghost::Plain> *)

use creusot.int.UInt64

function inv_usize [@inline:trivial] (_1: UInt64.t) : bool = true

meta "rewrite_def" function inv_usize

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: UInt64.t. inv_usize snap -> (forall result: UInt64.t. result = snap -> result = snap)
