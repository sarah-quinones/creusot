(* <i64 as ghost::Plain> *)

use creusot.int.Int64

function inv_i64 [@inline:trivial] (_1: Int64.t) : bool = true

meta "rewrite_def" function inv_i64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: Int64.t. inv_i64 snap -> (forall result: Int64.t. result = snap -> result = snap)
