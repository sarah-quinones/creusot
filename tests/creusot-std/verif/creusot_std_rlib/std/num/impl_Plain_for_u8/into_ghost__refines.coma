(* <u8 as ghost::Plain> *)

use creusot.int.UInt8

function inv_u8 [@inline:trivial] (_1: UInt8.t) : bool = true

meta "rewrite_def" function inv_u8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: UInt8.t. inv_u8 snap -> (forall result: UInt8.t. result = snap -> result = snap)
