(* <i8 as ghost::Plain> *)

use creusot.int.Int8

function inv_i8 [@inline:trivial] (_1: Int8.t) : bool = true

meta "rewrite_def" function inv_i8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: Int8.t. inv_i8 snap -> (forall result: Int8.t. result = snap -> result = snap)
