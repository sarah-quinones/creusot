(* <i16 as ghost::Plain> *)

use creusot.int.Int16

function inv_i16 [@inline:trivial] (_1: Int16.t) : bool = true

meta "rewrite_def" function inv_i16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: Int16.t. inv_i16 snap -> (forall result: Int16.t. result = snap -> result = snap)
