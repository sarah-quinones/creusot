(* <std::option::Option<T> as ghost::Plain> *)

type t_T

type t_Option_T = None | Some t_T

function inv_T (_1: t_T) : bool

function inv_Option_T (_1: t_Option_T) : bool

axiom inv_axiom [@rewrite]: forall _1: t_Option_T [inv_Option_T _1]. inv_Option_T _1
    = match _1 with
      | None -> true
      | Some f0 -> inv_T f0
      end

function invariant_Ghost_Option_T [@inline:trivial] (self: t_Option_T) : bool = inv_Option_T self

meta "rewrite_def" function invariant_Ghost_Option_T

function inv_Ghost_Option_T [@inline:trivial] (_1: t_Option_T) : bool = invariant_Ghost_Option_T _1

meta "rewrite_def" function inv_Ghost_Option_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: t_Option_T. inv_Option_T snap
    -> inv_Option_T snap
    /\ (forall result: t_Option_T. inv_Ghost_Option_T result /\ result = snap
      -> inv_Ghost_Option_T result /\ result = snap)
