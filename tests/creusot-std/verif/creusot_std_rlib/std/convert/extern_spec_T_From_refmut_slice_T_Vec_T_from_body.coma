function inv_ref_slice_T [@inline:trivial] (_1: Slice64.slice t_T) : bool = invariant_ref_slice_T _1

meta "rewrite_def" function inv_ref_slice_T

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

function view_Vec_T_Global (self: t_Vec_T_Global) : Seq.seq t_T

axiom view_Vec_T_Global_spec: forall self: t_Vec_T_Global [view_Vec_T_Global self]. Seq.length (view_Vec_T_Global self)
    <= UInt64.t'int const_MAX

function invariant_Vec_T_Global (self: t_Vec_T_Global) : bool = inv_Seq_T (view_Vec_T_Global self)

function inv_Vec_T_Global (_1: t_Vec_T_Global) : bool

axiom inv_axiom: forall _1: t_Vec_T_Global [inv_Vec_T_Global _1]. inv_Vec_T_Global _1 -> invariant_Vec_T_Global _1

function postcondition_clone (self: ()) (args: t_T) (result: t_T) : bool

axiom postcondition_fndef:
  forall args: t_T, result: t_T [postcondition_clone () args result]. postcondition_clone () args result
    -> (let self = args in inv_T result)

function precondition_clone (self: ()) (args: t_T) : bool

axiom precondition_fndef: forall args: t_T [precondition_clone () args]. (let self = args in inv_ref_T self)
    -> precondition_clone () args

function postcondition_once_clone (self: ()) (args: t_T) (result: t_T) : bool = postcondition_clone self args result

meta "rewrite_def" function postcondition_once_clone

let clone_T (self: t_T) (return (x: t_T)) = {[@stop_split] [@expl:clone requires] precondition_clone () self}
  any
  [ return (result: t_T) -> {[@stop_split] [@expl:clone ensures] postcondition_once_clone () self result}
    (! return {result}) ]

let to_vec_T (self: Slice64.slice t_T) (return (x: t_Vec_T_Global)) =
{[@stop_split] [@expl:to_vec 'self' type invariant] inv_ref_slice_T self}
  any
  [ return (result: t_Vec_T_Global) ->
  {[@stop_split] [@expl:to_vec_T ensures] ([@stop_split] [@expl:to_vec result type invariant] inv_Vec_T_Global result)
    /\ ([@stop_split] [@expl:to_vec ensures #0] Seq.length (view_Vec_T_Global result) = Seq.length (Slice64.view self))
    /\ ([@stop_split] [@expl:to_vec ensures #1] forall i: int. 0 <= i /\ i < Seq.length (Slice64.view self)
      -> postcondition_clone () (Seq.get (Slice64.view self) i) (Seq.get (view_Vec_T_Global result) i))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

