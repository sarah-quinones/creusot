meta "rewrite_def" function invariant_refmut_slice_T

function inv_refmut_slice_T [@inline:trivial] (_1: MutBorrow.t (Slice64.slice t_T)) : bool = invariant_refmut_slice_T _1

meta "rewrite_def" function inv_refmut_slice_T

function resolve_refmut_slice_T [@inline:trivial] (_1: MutBorrow.t (Slice64.slice t_T)) : bool = _1.final = _1.current

meta "rewrite_def" function resolve_refmut_slice_T

type t_Vec_T_Global

