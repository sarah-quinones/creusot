meta "rewrite_def" function invariant_Seq_T

function inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) : bool = invariant_Seq_T _1

meta "rewrite_def" function inv_Seq_T

function invariant_slice_T (self: Slice64.slice t_T) : bool = inv_Seq_T (Slice64.view self)

function inv_slice_T [@inline:trivial] (_1: Slice64.slice t_T) : bool = invariant_slice_T _1

meta "rewrite_def" function inv_slice_T

function invariant_refmut_slice_T [@inline:trivial] (self: MutBorrow.t (Slice64.slice t_T)) : bool =
  inv_slice_T self.current /\ inv_slice_T self.final

meta "rewrite_def" function invariant_refmut_slice_T

function inv_refmut_slice_T [@inline:trivial] (_1: MutBorrow.t (Slice64.slice t_T)) : bool = invariant_refmut_slice_T _1

meta "rewrite_def" function inv_refmut_slice_T

function resolve_refmut_slice_T [@inline:trivial] (_1: MutBorrow.t (Slice64.slice t_T)) : bool = _1.final = _1.current

meta "rewrite_def" function resolve_refmut_slice_T

function invariant_ref_slice_T [@inline:trivial] (self: Slice64.slice t_T) : bool = inv_slice_T self

meta "rewrite_def" function invariant_ref_slice_T

function inv_ref_slice_T [@inline:trivial] (_1: Slice64.slice t_T) : bool = invariant_ref_slice_T _1

meta "rewrite_def" function inv_ref_slice_T

function invariant_Box_slice_T_Global (self: Slice64.slice t_T) : bool = inv_slice_T self

function inv_Box_slice_T_Global [@inline:trivial] (_1: Slice64.slice t_T) : bool = invariant_Box_slice_T_Global _1

meta "rewrite_def" function inv_Box_slice_T_Global

function view_Box_slice_T_Global [@inline:trivial] (self: Slice64.slice t_T) : Seq.seq t_T = Slice64.view self

meta "rewrite_def" function view_Box_slice_T_Global

function postcondition_clone (self: ()) (args: t_T) (result: t_T) : bool

axiom postcondition_fndef:
  forall args: t_T, result: t_T [postcondition_clone () args result]. postcondition_clone () args result
    -> (let self = args in inv_T result)

function precondition_clone (self: ()) (args: t_T) : bool

axiom precondition_fndef: forall args: t_T [precondition_clone () args]. (let self = args in inv_ref_T self)
    -> precondition_clone () args

function postcondition_once_clone (self: ()) (args: t_T) (result: t_T) : bool = postcondition_clone self args result

meta "rewrite_def" function postcondition_once_clone

let clone_T (self: t_T) (return (x: t_T)) = {[@stop_split] [@expl:clone requires] precondition_clone () self}
  any
  [ return (result: t_T) -> {[@stop_split] [@expl:clone ensures] postcondition_once_clone () self result}
    (! return {result}) ]

let from_Box_slice_T_Global (slice: Slice64.slice t_T) (return (x: Slice64.slice t_T)) =
{[@stop_split] [@expl:from 'slice' type invariant] inv_ref_slice_T slice}
  any
  [ return (result: Slice64.slice t_T) ->
  {[@stop_split] [@expl:from_Box_slice_T_Global ensures] ([@stop_split] [@expl:from result type invariant] inv_Box_slice_T_Global result)
    /\ ([@stop_split] [@expl:from ensures #0] Seq.length (view_Box_slice_T_Global result)
      = Seq.length (Slice64.view slice))
    /\ ([@stop_split] [@expl:from ensures #1] forall i: int. 0 <= i /\ i < Seq.length (Slice64.view slice)
      -> postcondition_clone () (Seq.get (Slice64.view slice) i) (Seq.get (view_Box_slice_T_Global result) i))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

