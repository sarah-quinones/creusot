(* <std::slice::IterMut<'a, T> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.prelude.MutBorrow

type t_IterMut_T

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_T

function view_IterMut_T (self: t_IterMut_T) : MutBorrow.t (Slice64.slice t_T)

axiom view_IterMut_T_spec:
  forall self: t_IterMut_T [view_IterMut_T self]. Seq.length (Slice64.view (view_IterMut_T self).final)
    = Seq.length (Slice64.view (view_IterMut_T self).current)

function postcondition_size_hint (self: ()) (args: t_IterMut_T) (result: tup2_usize_Option_usize) : bool =
  let self'0 = args in UInt64.t'int result.f0 = Seq.length (Slice64.view (view_IterMut_T self'0).current)
  /\ result.f1 = Some (result.f0)

meta "rewrite_def" function postcondition_size_hint

function inv_IterMut_T (_1: t_IterMut_T) : bool

function invariant_ref_IterMut_T [@inline:trivial] (self: t_IterMut_T) : bool = inv_IterMut_T self

meta "rewrite_def" function invariant_ref_IterMut_T

function inv_ref_IterMut_T [@inline:trivial] (_1: t_IterMut_T) : bool = invariant_ref_IterMut_T _1

meta "rewrite_def" function inv_ref_IterMut_T

let size_hint_IterMut_T (self: t_IterMut_T) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_IterMut_T self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IterMut_T ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = Seq.length (Slice64.view (view_IterMut_T self).current))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_IterMut_T

constant r : tup2_usize_Option_usize

function size_hint_exact_IterMut_T (self: t_IterMut_T) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_exact_IterMut_T: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_exact ensures] r.f1 = Some (r.f0))
