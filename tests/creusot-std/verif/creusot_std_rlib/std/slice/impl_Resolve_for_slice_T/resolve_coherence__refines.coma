(* <[T] as resolve::Resolve> *)

use creusot.slice.Slice64
use seq.Seq
use int.Int

type t_T

function inv_T (_1: t_T) : bool

function invariant_ref_T [@inline:trivial] (self: t_T) : bool = inv_T self

meta "rewrite_def" function invariant_ref_T

function inv_ref_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_T _1

meta "rewrite_def" function inv_ref_T

function invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) : bool = forall i: int. 0 <= i /\ i < Seq.length self
    -> inv_ref_T (Seq.get self i)

meta "rewrite_def" function invariant_Seq_T

function inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) : bool = invariant_Seq_T _1

meta "rewrite_def" function inv_Seq_T

function invariant_slice_T (self: Slice64.slice t_T) : bool = inv_Seq_T (Slice64.view self)

function inv_slice_T [@inline:trivial] (_1: Slice64.slice t_T) : bool = invariant_slice_T _1

meta "rewrite_def" function inv_slice_T

function structural_resolve_slice_T (_1: Slice64.slice t_T) : bool

function resolve_T (_1: t_T) : bool

function index_slice_T [@inline:trivial] (self: Slice64.slice t_T) (ix: int) : t_T = Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_slice_T

function resolve_slice_T [@inline:trivial] (self: Slice64.slice t_T) : bool = forall i: int. 0 <= i
      /\ i < Seq.length (Slice64.view self) -> resolve_T (index_slice_T self i)

meta "rewrite_def" function resolve_slice_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Slice64.slice t_T. inv_slice_T self
    -> structural_resolve_slice_T self
    -> structural_resolve_slice_T self /\ (forall result: (). resolve_slice_T self -> resolve_slice_T self)
