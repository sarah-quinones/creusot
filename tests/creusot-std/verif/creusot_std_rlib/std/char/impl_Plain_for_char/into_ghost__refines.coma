(* <char as ghost::Plain> *)

use creusot.prelude.Char

function inv_char [@inline:trivial] (_1: Char.t) : bool = true

meta "rewrite_def" function inv_char

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: Char.t. inv_char snap -> (forall result: Char.t. result = snap -> result = snap)
