(* <[T; N] as resolve::Resolve> *)

use creusot.slice.Slice64
use seq.Seq
use creusot.int.UInt64
use int.Int

type t_T

function inv_T (_1: t_T) : bool

function invariant_ref_T [@inline:trivial] (self: t_T) : bool = inv_T self

meta "rewrite_def" function invariant_ref_T

function inv_ref_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_T _1

meta "rewrite_def" function inv_ref_T

function invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) : bool = forall i: int. 0 <= i /\ i < Seq.length self
    -> inv_ref_T (Seq.get self i)

meta "rewrite_def" function invariant_Seq_T

function inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) : bool = invariant_Seq_T _1

meta "rewrite_def" function inv_Seq_T

constant const_N : UInt64.t

function invariant_array_T_n (self: Slice64.array t_T) : bool = inv_Seq_T (Slice64.view self)
  /\ Seq.length (Slice64.view self) = UInt64.t'int const_N

function inv_array_T_n [@inline:trivial] (_1: Slice64.array t_T) : bool = invariant_array_T_n _1

meta "rewrite_def" function inv_array_T_n

function structural_resolve_array_T_n (_1: Slice64.array t_T) : bool

function resolve_T (_1: t_T) : bool

function resolve_array_T_n [@inline:trivial] (self: Slice64.array t_T) : bool = forall i: int. 0 <= i
      /\ i < UInt64.t'int const_N -> resolve_T (Seq.get (Slice64.view self) i)

meta "rewrite_def" function resolve_array_T_n

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Slice64.array t_T. inv_array_T_n self
    -> structural_resolve_array_T_n self
    -> structural_resolve_array_T_n self /\ (forall result: (). resolve_array_T_n self -> resolve_array_T_n self)
