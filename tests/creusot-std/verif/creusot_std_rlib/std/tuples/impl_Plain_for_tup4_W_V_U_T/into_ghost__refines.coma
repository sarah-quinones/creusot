(* <(W, V, U, T) as ghost::Plain> *)

type t_W

type t_V

type t_U

type t_T

type tup4_W_V_U_T = { f0: t_W; f1: t_V; f2: t_U; f3: t_T }

function inv_W (_1: t_W) : bool

function inv_V (_1: t_V) : bool

function inv_U (_1: t_U) : bool

function inv_T (_1: t_T) : bool

function inv_tup4_W_V_U_T [@inline:trivial] (_1: tup4_W_V_U_T) : bool = inv_W _1.f0
  /\ inv_V _1.f1 /\ inv_U _1.f2 /\ inv_T _1.f3

meta "rewrite_def" function inv_tup4_W_V_U_T

function invariant_Ghost_tup4_W_V_U_T [@inline:trivial] (self: tup4_W_V_U_T) : bool = inv_tup4_W_V_U_T self

meta "rewrite_def" function invariant_Ghost_tup4_W_V_U_T

function inv_Ghost_tup4_W_V_U_T [@inline:trivial] (_1: tup4_W_V_U_T) : bool = invariant_Ghost_tup4_W_V_U_T _1

meta "rewrite_def" function inv_Ghost_tup4_W_V_U_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: tup4_W_V_U_T. inv_tup4_W_V_U_T snap
    -> inv_tup4_W_V_U_T snap
    /\ (forall result: tup4_W_V_U_T. inv_Ghost_tup4_W_V_U_T result /\ result = snap
      -> inv_Ghost_tup4_W_V_U_T result /\ result = snap)
