(* <(U, T) as ghost::Plain> *)

type t_U

type t_T

type tup2_U_T = { f0: t_U; f1: t_T }

function inv_U (_1: t_U) : bool

function inv_T (_1: t_T) : bool

function inv_tup2_U_T [@inline:trivial] (_1: tup2_U_T) : bool = inv_U _1.f0 /\ inv_T _1.f1

meta "rewrite_def" function inv_tup2_U_T

function invariant_Ghost_tup2_U_T [@inline:trivial] (self: tup2_U_T) : bool = inv_tup2_U_T self

meta "rewrite_def" function invariant_Ghost_tup2_U_T

function inv_Ghost_tup2_U_T [@inline:trivial] (_1: tup2_U_T) : bool = invariant_Ghost_tup2_U_T _1

meta "rewrite_def" function inv_Ghost_tup2_U_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: tup2_U_T. inv_tup2_U_T snap
    -> inv_tup2_U_T snap
    /\ (forall result: tup2_U_T. inv_Ghost_tup2_U_T result /\ result = snap
      -> inv_Ghost_tup2_U_T result /\ result = snap)
