(* <(T,) as ghost::Plain> *)

type t_T

function inv_T (_1: t_T) : bool

function inv_tup1_T [@inline:trivial] (_1: t_T) : bool = inv_T _1

meta "rewrite_def" function inv_tup1_T

function invariant_Ghost_tup1_T [@inline:trivial] (self: t_T) : bool = inv_tup1_T self

meta "rewrite_def" function invariant_Ghost_tup1_T

function inv_Ghost_tup1_T [@inline:trivial] (_1: t_T) : bool = invariant_Ghost_tup1_T _1

meta "rewrite_def" function inv_Ghost_tup1_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: t_T. inv_tup1_T snap
    -> inv_tup1_T snap
    /\ (forall result: t_T. inv_Ghost_tup1_T result /\ result = snap -> inv_Ghost_tup1_T result /\ result = snap)
