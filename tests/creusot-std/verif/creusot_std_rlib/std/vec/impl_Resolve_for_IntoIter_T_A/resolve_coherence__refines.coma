(* <std::vec::IntoIter<T, A> as resolve::Resolve> *)

use seq.Seq
use int.Int

type t_IntoIter_T_A

function inv_IntoIter_T_A (_1: t_IntoIter_T_A) : bool

function structural_resolve_IntoIter_T_A (_1: t_IntoIter_T_A) : bool

type t_T

function view_IntoIter_T_A (self: t_IntoIter_T_A) : Seq.seq t_T

function resolve_T (_1: t_T) : bool

function resolve_IntoIter_T_A [@inline:trivial] (self: t_IntoIter_T_A) : bool = forall i: int. 0 <= i
      /\ i < Seq.length (view_IntoIter_T_A self) -> resolve_T (Seq.get (view_IntoIter_T_A self) i)

meta "rewrite_def" function resolve_IntoIter_T_A

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_IntoIter_T_A. inv_IntoIter_T_A self
    -> structural_resolve_IntoIter_T_A self
    -> structural_resolve_IntoIter_T_A self
    /\ (forall result: (). resolve_IntoIter_T_A self -> resolve_IntoIter_T_A self)
