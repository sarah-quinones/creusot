(* <std::vec::IntoIter<T, A> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt64
use seq.Seq

type t_IntoIter_T_A

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_T

function view_IntoIter_T_A (self: t_IntoIter_T_A) : Seq.seq t_T

function postcondition_size_hint (self: ()) (args: t_IntoIter_T_A) (result: tup2_usize_Option_usize) : bool =
  let self'0 = args in UInt64.t'int result.f0 = Seq.length (view_IntoIter_T_A self'0) /\ result.f1 = Some (result.f0)

meta "rewrite_def" function postcondition_size_hint

function inv_IntoIter_T_A (_1: t_IntoIter_T_A) : bool

function invariant_ref_IntoIter_T_A [@inline:trivial] (self: t_IntoIter_T_A) : bool = inv_IntoIter_T_A self

meta "rewrite_def" function invariant_ref_IntoIter_T_A

function inv_ref_IntoIter_T_A [@inline:trivial] (_1: t_IntoIter_T_A) : bool = invariant_ref_IntoIter_T_A _1

meta "rewrite_def" function inv_ref_IntoIter_T_A

let size_hint_IntoIter_T_A (self: t_IntoIter_T_A) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_IntoIter_T_A self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IntoIter_T_A ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = Seq.length (view_IntoIter_T_A self))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_IntoIter_T_A, r: tup2_usize_Option_usize. postcondition_size_hint () self r
    -> postcondition_size_hint () self r /\ (forall result: (). r.f1 = Some (r.f0) -> r.f1 = Some (r.f0))
