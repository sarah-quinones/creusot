(* <std::thread::JoinHandle<T> as std::thread::JoinHandleExt<T>> *)

type t_JoinHandle_T

function inv_JoinHandle_T (_1: t_JoinHandle_T) : bool

type t_T

function inv_T (_1: t_T) : bool

function valid_result_JoinHandle_T (self: t_JoinHandle_T) (_x: t_T) : bool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_JoinHandle_T. inv_JoinHandle_T self
    -> inv_JoinHandle_T self
    /\ (forall result: t_T. inv_T result /\ valid_result_JoinHandle_T self result
      -> inv_T result /\ valid_result_JoinHandle_T self result)
