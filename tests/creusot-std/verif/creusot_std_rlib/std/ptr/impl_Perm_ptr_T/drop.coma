(* ghost::perm::Perm<*const T> *)

use creusot.prelude.Opaque
use creusot.prelude.Ptr
use creusot.int.UInt64
use creusot.prelude.Any

type t_Perm_ptr_T

type t_T

function is_null_ptr_T (self: Opaque.ptr) : bool = Ptr.addr_logic_u64 self = (0: UInt64.t)

function ward_ptr_T (self: t_Perm_ptr_T) : Opaque.ptr

type t_Metadata

function metadata_matches_T (_value: t_T) (_metadata: t_Metadata) : bool

function val_unsized_ptr_T (self: t_Perm_ptr_T) : t_T

function metadata_T (_1: Opaque.ptr) : t_Metadata

function inv_T (_1: t_T) : bool

function invariant_ref_T [@inline:trivial] (self: t_T) : bool = inv_T self

meta "rewrite_def" function invariant_ref_T

function inv_ref_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_T _1

meta "rewrite_def" function inv_ref_T

function invariant_Perm_ptr_T (self: t_Perm_ptr_T) : bool = not is_null_ptr_T (ward_ptr_T self)
  /\ metadata_matches_T (val_unsized_ptr_T self) (metadata_T (ward_ptr_T self)) /\ inv_ref_T (val_unsized_ptr_T self)

function inv_Perm_ptr_T (_1: t_Perm_ptr_T) : bool

axiom inv_axiom [@rewrite]: forall _1: t_Perm_ptr_T [inv_Perm_ptr_T _1]. inv_Perm_ptr_T _1 = invariant_Perm_ptr_T _1

function invariant_Ghost_Perm_ptr_T [@inline:trivial] (self: t_Perm_ptr_T) : bool = inv_Perm_ptr_T self

meta "rewrite_def" function invariant_Ghost_Perm_ptr_T

function inv_Ghost_Perm_ptr_T [@inline:trivial] (_1: t_Perm_ptr_T) : bool = invariant_Ghost_Perm_ptr_T _1

meta "rewrite_def" function inv_Ghost_Perm_ptr_T

function invariant_Box_T_Global (self: t_T) : bool = inv_T self

function inv_Box_T_Global [@inline:trivial] (_1: t_T) : bool = invariant_Box_T_Global _1

meta "rewrite_def" function inv_Box_T_Global

let to_box_T (ptr: Opaque.ptr) (own: t_Perm_ptr_T) (return (x: t_T)) =
{[@stop_split] [@expl:to_box_T requires] ([@stop_split] [@expl:to_box 'own' type invariant] inv_Ghost_Perm_ptr_T own)
  /\ ([@stop_split] [@expl:to_box requires] ptr = ward_ptr_T own)}
  any
  [ return (result: t_T) ->
  {[@stop_split] [@expl:to_box_T ensures] ([@stop_split] [@expl:to_box result type invariant] inv_Box_T_Global result)
    /\ ([@stop_split] [@expl:to_box ensures] result = val_unsized_ptr_T own)}
    (! return {result}) ]

function resolve_T (_1: t_T) : bool

function resolve_Box_T_Global [@inline:trivial] (_1: t_T) : bool = resolve_T _1

meta "rewrite_def" function resolve_Box_T_Global

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let drop_T (ptr: Opaque.ptr) (own: t_Perm_ptr_T) (return (x: ())) =
{[@stop_split] [@expl:drop_T requires] ([@stop_split] [@expl:drop 'own' type invariant] inv_Ghost_Perm_ptr_T own)
  /\ ([@stop_split] [@expl:drop requires] ptr = ward_ptr_T own)}
  (! bb0
  [ bb0 = s0
    [ s0 = to_box_T {ptr} {own} (fun (_x: t_T) -> [ &_6 <- _x ] s1)
    | s1 = s2 [ _ck -> (! {[@expl:type invariant] inv_Box_T_Global _6} any) ]
    | s2 = -{resolve_Box_T_Global _6}- s3
    | s3 = return {_ret} ] ]
  [ & _ret: () = Any.any_l () | & ptr: Opaque.ptr = ptr | & own: t_Perm_ptr_T = own | & _6: t_T = Any.any_l () ])
  [ return (result: ()) -> (! return {result}) ]
