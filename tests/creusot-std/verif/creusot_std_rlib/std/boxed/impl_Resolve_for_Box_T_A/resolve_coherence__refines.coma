(* <std::boxed::Box<T, A> as resolve::Resolve> *)

type t_T

function inv_T (_1: t_T) : bool

function invariant_Box_T_A (self: t_T) : bool = inv_T self

function inv_Box_T_A [@inline:trivial] (_1: t_T) : bool = invariant_Box_T_A _1

meta "rewrite_def" function inv_Box_T_A

function resolve_T (_1: t_T) : bool

function structural_resolve_Box_T_A (_1: t_T) : bool = resolve_T _1

function resolve_Box_T_A [@inline:trivial] (self: t_T) : bool = true

meta "rewrite_def" function resolve_Box_T_A

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_T. inv_Box_T_A self
    -> structural_resolve_Box_T_A self
    -> structural_resolve_Box_T_A self /\ (forall result: (). resolve_Box_T_A self -> resolve_Box_T_A self)
