(* <std::iter::Skip<I> as resolve::Resolve> *)

type t_Skip_I

function inv_Skip_I (_1: t_Skip_I) : bool

function structural_resolve_Skip_I (_1: t_Skip_I) : bool

type t_I

function resolve_I (_1: t_I) : bool

function iter_Skip_I (self: t_Skip_I) : t_I

function resolve_Skip_I [@inline:trivial] (self: t_Skip_I) : bool = resolve_I (iter_Skip_I self)

meta "rewrite_def" function resolve_Skip_I

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Skip_I. inv_Skip_I self
    -> structural_resolve_Skip_I self
    -> structural_resolve_Skip_I self /\ (forall result: (). resolve_Skip_I self -> resolve_Skip_I self)
