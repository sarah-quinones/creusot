(* <std::iter::Map<I, F> as resolve::Resolve> *)

type t_Map_I_F

function inv_Map_I_F (_1: t_Map_I_F) : bool

function structural_resolve_Map_I_F (_1: t_Map_I_F) : bool

type t_I

function resolve_I (_1: t_I) : bool

function iter_Map_I_F (self: t_Map_I_F) : t_I

type t_F

function resolve_F (_1: t_F) : bool

function func_Map_I_F (self: t_Map_I_F) : t_F

function resolve_Map_I_F [@inline:trivial] (self: t_Map_I_F) : bool = resolve_I (iter_Map_I_F self)
  /\ resolve_F (func_Map_I_F self)

meta "rewrite_def" function resolve_Map_I_F

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Map_I_F. inv_Map_I_F self
    -> structural_resolve_Map_I_F self
    -> structural_resolve_Map_I_F self /\ (forall result: (). resolve_Map_I_F self -> resolve_Map_I_F self)
