(* <std::iter::Map<I, F> as invariant::Invariant> *)

use seq.Seq
use creusot.prelude.MutBorrow
use int.Int

type t_Map_I_F

type t_I

function inv_I (_1: t_I) : bool

function iter_Map_I_F (self: t_Map_I_F) : t_I

type t_F

function inv_F (_1: t_F) : bool

function func_Map_I_F (self: t_Map_I_F) : t_F

type t_Item

function produces_I (self: t_I) (visited: Seq.seq t_Item) (o: t_I) : bool

function produces_trans_I (a: t_I) (ab: Seq.seq t_Item) (b: t_I) (bc: Seq.seq t_Item) (c: t_I) : ()

axiom produces_trans_I_spec: forall a: t_I, ab: Seq.seq t_Item, b: t_I, bc: Seq.seq t_Item, c: t_I. produces_I a ab b
    -> produces_I b bc c -> produces_I a (Seq.(++) ab bc) c

function produces_refl_I (self: t_I) : ()

axiom produces_refl_I_spec: forall self: t_I. produces_I self (Seq.empty: Seq.seq t_Item) self

function completed_I (self: MutBorrow.t t_I) : bool

function inv_Item (_1: t_Item) : bool

function precondition_F (self: t_F) (args: t_Item) : bool

function next_precondition_I [@inline:trivial] (iter: t_I) (func: t_F) : bool =
  forall e: t_Item, i: t_I [produces_I iter (Seq.singleton e) i]. inv_Item e /\ produces_I iter (Seq.singleton e) i
    -> precondition_F func e

meta "rewrite_def" function next_precondition_I

type t_B

function postcondition_once_F (self: t_F) (args: t_Item) (result: t_B) : bool

function resolve_F (_1: t_F) : bool

function postcondition_mut_F (self: t_F) (args: t_Item) (result_state: t_F) (result: t_B) : bool

function fn_mut_once_F (self: t_F) (args: t_Item) (res: t_B) : ()

axiom fn_mut_once_F_spec:
  forall self: t_F, args: t_Item, res: t_B [postcondition_once_F self args res]. postcondition_once_F self args res
    = (exists res_state: t_F. postcondition_mut_F self args res_state res /\ resolve_F res_state)

function hist_inv_F (self: t_F) (result_state: t_F) : bool

function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()

axiom hist_inv_trans_F_spec:
  forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
    -> hist_inv_F b c -> hist_inv_F self c

function hist_inv_refl_F (self: t_F) : ()

axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self

function postcondition_mut_hist_inv_F (self: t_F) (args: t_Item) (res_state: t_F) (res: t_B) : ()

axiom postcondition_mut_hist_inv_F_spec:
  forall self: t_F, args: t_Item, res_state: t_F, res: t_B [postcondition_mut_F self args res_state res | hist_inv_F self res_state]. postcondition_mut_F self args res_state res
    -> hist_inv_F self res_state

function invariant_ref_Item [@inline:trivial] (self: t_Item) : bool = inv_Item self

meta "rewrite_def" function invariant_ref_Item

function inv_ref_Item [@inline:trivial] (_1: t_Item) : bool = invariant_ref_Item _1

meta "rewrite_def" function inv_ref_Item

function invariant_Seq_Item [@inline:trivial] (self: Seq.seq t_Item) : bool = forall i: int. 0 <= i
      /\ i < Seq.length self -> inv_ref_Item (Seq.get self i)

meta "rewrite_def" function invariant_Seq_Item

function inv_Seq_Item [@inline:trivial] (_1: Seq.seq t_Item) : bool = invariant_Seq_Item _1

meta "rewrite_def" function inv_Seq_Item

function invariant_refmut_F [@inline:trivial] (self: MutBorrow.t t_F) : bool = inv_F self.current /\ inv_F self.final

meta "rewrite_def" function invariant_refmut_F

function inv_refmut_F [@inline:trivial] (_1: MutBorrow.t t_F) : bool = invariant_refmut_F _1

meta "rewrite_def" function inv_refmut_F

function preservation_I [@inline:trivial] (iter: t_I) (func: t_F) : bool =
  forall s: Seq.seq t_Item, e1: t_Item, e2: t_Item, f: MutBorrow.t t_F, b: t_B, i: t_I [produces_I iter (Seq.snoc (Seq.snoc s e1) e2) i, postcondition_mut_F f.current e1 f.final b]. hist_inv_F func f.current
    -> inv_Seq_Item s /\ inv_Item e1 /\ inv_Item e2 /\ inv_refmut_F f
    -> produces_I iter (Seq.snoc (Seq.snoc s e1) e2) i
    -> postcondition_mut_F f.current e1 f.final b -> precondition_F f.final e2

meta "rewrite_def" function preservation_I

constant reinitialize_I: bool = forall iter: MutBorrow.t t_I, func: t_F. completed_I iter
  -> next_precondition_I iter.final func /\ preservation_I iter.final func

meta "rewrite_def" constant reinitialize_I

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Map_I_F

function invariant_Map_I_F (self: t_Map_I_F) : bool

goal vc_invariant_Map_I_F: [@stop_split] [@expl:invariant ensures] inv_I (iter_Map_I_F self)
    /\ inv_F (func_Map_I_F self)
    /\ reinitialize_I
    /\ preservation_I (iter_Map_I_F self) (func_Map_I_F self)
    /\ next_precondition_I (iter_Map_I_F self) (func_Map_I_F self)
  -> inv_I (iter_Map_I_F self) /\ inv_F (func_Map_I_F self)
