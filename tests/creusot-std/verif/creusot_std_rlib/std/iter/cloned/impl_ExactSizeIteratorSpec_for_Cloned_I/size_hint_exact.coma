(* <std::iter::Cloned<I> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use int.Int

type t_Cloned_I

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_I

type t_T

function produces_I (self: t_I) (visited: Seq.seq t_T) (o: t_I) : bool

function produces_trans_I (a: t_I) (ab: Seq.seq t_T) (b: t_I) (bc: Seq.seq t_T) (c: t_I) : ()

axiom produces_trans_I_spec: forall a: t_I, ab: Seq.seq t_T, b: t_I, bc: Seq.seq t_T, c: t_I. produces_I a ab b
    -> produces_I b bc c -> produces_I a (Seq.(++) ab bc) c

function produces_refl_I (self: t_I) : ()

axiom produces_refl_I_spec: forall self: t_I. produces_I self (Seq.empty: Seq.seq t_T) self

function completed_I (self: MutBorrow.t t_I) : bool

function postcondition_size_hint (self: ()) (args: t_I) (result: tup2_usize_Option_usize) : bool

axiom postcondition_fndef:
  forall args: t_I, result: tup2_usize_Option_usize [postcondition_size_hint () args result]. postcondition_size_hint () args result
    -> (let self = args in (forall s: Seq.seq t_T, i: MutBorrow.t t_I. produces_I self s i.current /\ completed_I i
        -> UInt64.t'int result.f0 <= Seq.length s)
    /\ match result.f1 with
      | Some r -> forall s: Seq.seq t_T, i: t_I. produces_I self s i -> Seq.length s <= UInt64.t'int r
      | None -> true
      end)

function iter_Cloned_I (self: t_Cloned_I) : t_I

function postcondition_size_hint'0 (self: ()) (args: t_Cloned_I) (result: tup2_usize_Option_usize) : bool =
  let self'0 = args in postcondition_size_hint () (iter_Cloned_I self'0) result

meta "rewrite_def" function postcondition_size_hint'0

function inv_I (_1: t_I) : bool

function invariant_Cloned_I [@inline:trivial] (self: t_Cloned_I) : bool = inv_I (iter_Cloned_I self)

meta "rewrite_def" function invariant_Cloned_I

function inv_Cloned_I (_1: t_Cloned_I) : bool

axiom inv_axiom: forall _1: t_Cloned_I [inv_Cloned_I _1]. inv_Cloned_I _1 -> invariant_Cloned_I _1

function invariant_ref_Cloned_I [@inline:trivial] (self: t_Cloned_I) : bool = inv_Cloned_I self

meta "rewrite_def" function invariant_ref_Cloned_I

function inv_ref_Cloned_I [@inline:trivial] (_1: t_Cloned_I) : bool = invariant_ref_Cloned_I _1

meta "rewrite_def" function inv_ref_Cloned_I

function invariant_ref_I [@inline:trivial] (self: t_I) : bool = inv_I self

meta "rewrite_def" function invariant_ref_I

function inv_ref_I [@inline:trivial] (_1: t_I) : bool = invariant_ref_I _1

meta "rewrite_def" function inv_ref_I

function precondition_size_hint (self: ()) (args: t_I) : bool

axiom precondition_fndef: forall args: t_I [precondition_size_hint () args]. (let self = args in inv_ref_I self)
    -> precondition_size_hint () args

function postcondition_once_size_hint (self: ()) (args: t_I) (result: tup2_usize_Option_usize) : bool =
  postcondition_size_hint self args result

meta "rewrite_def" function postcondition_once_size_hint

let size_hint_I (self: t_I) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint requires] precondition_size_hint () self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] postcondition_once_size_hint () self result}
    (! return {result}) ]

let size_hint_Cloned_I (self: t_Cloned_I) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_Cloned_I self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] postcondition_size_hint () (iter_Cloned_I self) result}
    (! return {result}) ]

function size_hint_exact_I (self: t_I) (r: tup2_usize_Option_usize) : ()

axiom size_hint_exact_I_spec: forall self: t_I, r: tup2_usize_Option_usize. postcondition_size_hint () self r
    -> r.f1 = Some (r.f0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Cloned_I

constant r : tup2_usize_Option_usize

function size_hint_exact_Cloned_I (self: t_Cloned_I) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_exact_Cloned_I: postcondition_size_hint'0 () self r
  -> ([@stop_split] [@expl:size_hint_exact requires] postcondition_size_hint () (iter_Cloned_I self) r)
  /\ (([@stop_split] [@expl:size_hint_exact ensures] r.f1 = Some (r.f0))
  -> ([@stop_split] [@expl:size_hint_exact ensures] r.f1 = Some (r.f0)))
