(* <std::iter::Zip<A, B> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use int.Int

type t_Zip_A_B

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_A

type t_Item

function produces_A (self: t_A) (visited: Seq.seq t_Item) (o: t_A) : bool

function produces_trans_A (a: t_A) (ab: Seq.seq t_Item) (b: t_A) (bc: Seq.seq t_Item) (c: t_A) : ()

axiom produces_trans_A_spec: forall a: t_A, ab: Seq.seq t_Item, b: t_A, bc: Seq.seq t_Item, c: t_A. produces_A a ab b
    -> produces_A b bc c -> produces_A a (Seq.(++) ab bc) c

function produces_refl_A (self: t_A) : ()

axiom produces_refl_A_spec: forall self: t_A. produces_A self (Seq.empty: Seq.seq t_Item) self

function completed_A (self: MutBorrow.t t_A) : bool

function postcondition_size_hint (self: ()) (args: t_A) (result: tup2_usize_Option_usize) : bool

axiom postcondition_fndef:
  forall args: t_A, result: tup2_usize_Option_usize [postcondition_size_hint () args result]. postcondition_size_hint () args result
    -> (let self = args in (forall s: Seq.seq t_Item, i: MutBorrow.t t_A. produces_A self s i.current /\ completed_A i
        -> UInt64.t'int result.f0 <= Seq.length s)
    /\ match result.f1 with
      | Some r -> forall s: Seq.seq t_Item, i: t_A. produces_A self s i -> Seq.length s <= UInt64.t'int r
      | None -> true
      end)

function iter_a_Zip_A_B (self: t_Zip_A_B) : t_A

type t_B

type t_Item'0

function produces_B (self: t_B) (visited: Seq.seq t_Item'0) (o: t_B) : bool

function produces_trans_B (a: t_B) (ab: Seq.seq t_Item'0) (b: t_B) (bc: Seq.seq t_Item'0) (c: t_B) : ()

axiom produces_trans_B_spec:
  forall a: t_B, ab: Seq.seq t_Item'0, b: t_B, bc: Seq.seq t_Item'0, c: t_B. produces_B a ab b
    -> produces_B b bc c -> produces_B a (Seq.(++) ab bc) c

function produces_refl_B (self: t_B) : ()

axiom produces_refl_B_spec: forall self: t_B. produces_B self (Seq.empty: Seq.seq t_Item'0) self

function completed_B (self: MutBorrow.t t_B) : bool

function postcondition_size_hint'0 (self: ()) (args: t_B) (result: tup2_usize_Option_usize) : bool

axiom postcondition_fndef'0:
  forall args: t_B, result: tup2_usize_Option_usize [postcondition_size_hint'0 () args result]. postcondition_size_hint'0 () args result
    -> (let self = args in (forall s: Seq.seq t_Item'0, i: MutBorrow.t t_B. produces_B self s i.current /\ completed_B i
        -> UInt64.t'int result.f0 <= Seq.length s)
    /\ match result.f1 with
      | Some r -> forall s: Seq.seq t_Item'0, i: t_B. produces_B self s i -> Seq.length s <= UInt64.t'int r
      | None -> true
      end)

function iter_b_Zip_A_B (self: t_Zip_A_B) : t_B

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

type tup2_Option_usize_Option_usize = { f0'0: t_Option_usize; f1'0: t_Option_usize }

function postcondition_size_hint'1 (self: ()) (args: t_Zip_A_B) (result: tup2_usize_Option_usize) : bool =
  let self'0 = args in exists ra: tup2_usize_Option_usize, rb: tup2_usize_Option_usize. postcondition_size_hint () (iter_a_Zip_A_B self'0) ra
    /\ postcondition_size_hint'0 () (iter_b_Zip_A_B self'0) rb
    /\ (UInt64.t'int ra.f0 <= UInt64.t'int rb.f0 -> result.f0 = ra.f0)
    /\ (ge_log_Int (UInt64.t'int ra.f0) (UInt64.t'int rb.f0) -> result.f0 = rb.f0)
    /\ match { f0'0 = ra.f1; f1'0 = rb.f1 } with
      | {f0'0 = Some ua; f1'0 = Some ub} -> (UInt64.t'int ua <= UInt64.t'int ub -> result.f1 = Some ua)
      /\ (ge_log_Int (UInt64.t'int ua) (UInt64.t'int ub) -> result.f1 = Some ub)
      | {f0'0 = Some ua; f1'0 = None} -> result.f1 = Some ua
      | {f0'0 = None; f1'0 = Some ub} -> result.f1 = Some ub
      | {f0'0 = None; f1'0 = None} -> result.f1 = None
      end

meta "rewrite_def" function postcondition_size_hint'1

function inv_A (_1: t_A) : bool

function inv_B (_1: t_B) : bool

function invariant_Zip_A_B [@inline:trivial] (self: t_Zip_A_B) : bool = inv_A (iter_a_Zip_A_B self)
  /\ inv_B (iter_b_Zip_A_B self)

meta "rewrite_def" function invariant_Zip_A_B

function inv_Zip_A_B (_1: t_Zip_A_B) : bool

axiom inv_axiom: forall _1: t_Zip_A_B [inv_Zip_A_B _1]. inv_Zip_A_B _1 -> invariant_Zip_A_B _1

function invariant_ref_Zip_A_B [@inline:trivial] (self: t_Zip_A_B) : bool = inv_Zip_A_B self

meta "rewrite_def" function invariant_ref_Zip_A_B

function inv_ref_Zip_A_B [@inline:trivial] (_1: t_Zip_A_B) : bool = invariant_ref_Zip_A_B _1

meta "rewrite_def" function inv_ref_Zip_A_B

function invariant_ref_A [@inline:trivial] (self: t_A) : bool = inv_A self

meta "rewrite_def" function invariant_ref_A

function inv_ref_A [@inline:trivial] (_1: t_A) : bool = invariant_ref_A _1

meta "rewrite_def" function inv_ref_A

function precondition_size_hint (self: ()) (args: t_A) : bool

axiom precondition_fndef: forall args: t_A [precondition_size_hint () args]. (let self = args in inv_ref_A self)
    -> precondition_size_hint () args

function postcondition_once_size_hint (self: ()) (args: t_A) (result: tup2_usize_Option_usize) : bool =
  postcondition_size_hint self args result

meta "rewrite_def" function postcondition_once_size_hint

let size_hint_A (self: t_A) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint requires] precondition_size_hint () self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] postcondition_once_size_hint () self result}
    (! return {result}) ]

function invariant_ref_B [@inline:trivial] (self: t_B) : bool = inv_B self

meta "rewrite_def" function invariant_ref_B

function inv_ref_B [@inline:trivial] (_1: t_B) : bool = invariant_ref_B _1

meta "rewrite_def" function inv_ref_B

function precondition_size_hint'0 (self: ()) (args: t_B) : bool

axiom precondition_fndef'0: forall args: t_B [precondition_size_hint'0 () args]. (let self = args in inv_ref_B self)
    -> precondition_size_hint'0 () args

function postcondition_once_size_hint'0 (self: ()) (args: t_B) (result: tup2_usize_Option_usize) : bool =
  postcondition_size_hint'0 self args result

meta "rewrite_def" function postcondition_once_size_hint'0

let size_hint_B (self: t_B) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint requires] precondition_size_hint'0 () self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] postcondition_once_size_hint'0 () self result}
    (! return {result}) ]

let size_hint_Zip_A_B (self: t_Zip_A_B) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_Zip_A_B self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] exists ra: tup2_usize_Option_usize, rb: tup2_usize_Option_usize. postcondition_size_hint () (iter_a_Zip_A_B self) ra
      /\ postcondition_size_hint'0 () (iter_b_Zip_A_B self) rb
      /\ (UInt64.t'int ra.f0 <= UInt64.t'int rb.f0 -> result.f0 = ra.f0)
      /\ (ge_log_Int (UInt64.t'int ra.f0) (UInt64.t'int rb.f0) -> result.f0 = rb.f0)
      /\ match { f0'0 = ra.f1; f1'0 = rb.f1 } with
        | {f0'0 = Some ua; f1'0 = Some ub} -> (UInt64.t'int ua <= UInt64.t'int ub -> result.f1 = Some ua)
        /\ (ge_log_Int (UInt64.t'int ua) (UInt64.t'int ub) -> result.f1 = Some ub)
        | {f0'0 = Some ua; f1'0 = None} -> result.f1 = Some ua
        | {f0'0 = None; f1'0 = Some ub} -> result.f1 = Some ub
        | {f0'0 = None; f1'0 = None} -> result.f1 = None
        end}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Zip_A_B, r: tup2_usize_Option_usize. postcondition_size_hint'1 () self r
    -> postcondition_size_hint'1 () self r /\ (forall result: (). r.f1 = Some (r.f0) -> r.f1 = Some (r.f0))
