(* <std::iter::Chain<A, B> as resolve::Resolve> *)

type t_Chain_A_B

type t_A

type t_Option_A = None | Some t_A

function inv_A (_1: t_A) : bool

function inv_Option_A (_1: t_Option_A) : bool

axiom inv_axiom [@rewrite]: forall _1: t_Option_A [inv_Option_A _1]. inv_Option_A _1
    = match _1 with
      | None -> true
      | Some f0 -> inv_A f0
      end

function iter_a_Chain_A_B (self: t_Chain_A_B) : t_Option_A

type t_B

type t_Option_B = None'0 | Some'0 t_B

function inv_B (_1: t_B) : bool

function inv_Option_B (_1: t_Option_B) : bool

axiom inv_axiom'0 [@rewrite]: forall _1: t_Option_B [inv_Option_B _1]. inv_Option_B _1
    = match _1 with
      | None'0 -> true
      | Some'0 f0 -> inv_B f0
      end

function iter_b_Chain_A_B (self: t_Chain_A_B) : t_Option_B

function invariant_Chain_A_B (self: t_Chain_A_B) : bool = inv_Option_A (iter_a_Chain_A_B self)
  /\ inv_Option_B (iter_b_Chain_A_B self)

function inv_Chain_A_B (_1: t_Chain_A_B) : bool

axiom inv_axiom'1: forall _1: t_Chain_A_B [inv_Chain_A_B _1]. inv_Chain_A_B _1 -> invariant_Chain_A_B _1

function structural_resolve_Chain_A_B (_1: t_Chain_A_B) : bool

function resolve_A (_1: t_A) : bool

function resolve_Option_A (_1: t_Option_A) : bool

axiom resolve_axiom [@rewrite]: forall _1: t_Option_A [resolve_Option_A _1]. resolve_Option_A _1
    = match _1 with
      | None -> true
      | Some x0 -> resolve_A x0
      end

function resolve_B (_1: t_B) : bool

function resolve_Option_B (_1: t_Option_B) : bool

axiom resolve_axiom'0 [@rewrite]: forall _1: t_Option_B [resolve_Option_B _1]. resolve_Option_B _1
    = match _1 with
      | None'0 -> true
      | Some'0 x0 -> resolve_B x0
      end

function resolve_Chain_A_B [@inline:trivial] (self: t_Chain_A_B) : bool = resolve_Option_A (iter_a_Chain_A_B self)
  /\ resolve_Option_B (iter_b_Chain_A_B self)

meta "rewrite_def" function resolve_Chain_A_B

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Chain_A_B. inv_Chain_A_B self
    -> structural_resolve_Chain_A_B self
    -> structural_resolve_Chain_A_B self /\ (forall result: (). resolve_Chain_A_B self -> resolve_Chain_A_B self)
