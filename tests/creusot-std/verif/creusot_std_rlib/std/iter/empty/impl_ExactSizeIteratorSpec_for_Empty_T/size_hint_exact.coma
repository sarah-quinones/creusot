(* <std::iter::Empty<T> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt64

type t_Empty_T

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

function postcondition_size_hint (self: ()) (args: t_Empty_T) (result: tup2_usize_Option_usize) : bool =
  let self'0 = args in result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) }

meta "rewrite_def" function postcondition_size_hint

function inv_Empty_T (_1: t_Empty_T) : bool

function invariant_ref_Empty_T [@inline:trivial] (self: t_Empty_T) : bool = inv_Empty_T self

meta "rewrite_def" function invariant_ref_Empty_T

function inv_ref_Empty_T [@inline:trivial] (_1: t_Empty_T) : bool = invariant_ref_Empty_T _1

meta "rewrite_def" function inv_ref_Empty_T

let size_hint_Empty_T (self: t_Empty_T) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_Empty_T self}
  any
  [ return (result: tup2_usize_Option_usize) -> {[@stop_split] [@expl:size_hint ensures] result
    = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) }}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Empty_T

constant r : tup2_usize_Option_usize

function size_hint_exact_Empty_T (self: t_Empty_T) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_exact_Empty_T: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_exact ensures] r.f1 = Some (r.f0))
