(* <std::iter::Copied<I> as resolve::Resolve> *)

type t_Copied_I

type t_I

function inv_I (_1: t_I) : bool

function iter_Copied_I (self: t_Copied_I) : t_I

function invariant_Copied_I [@inline:trivial] (self: t_Copied_I) : bool = inv_I (iter_Copied_I self)

meta "rewrite_def" function invariant_Copied_I

function inv_Copied_I (_1: t_Copied_I) : bool

axiom inv_axiom: forall _1: t_Copied_I [inv_Copied_I _1]. inv_Copied_I _1 -> invariant_Copied_I _1

function structural_resolve_Copied_I (_1: t_Copied_I) : bool

function resolve_I (_1: t_I) : bool

function resolve_Copied_I [@inline:trivial] (self: t_Copied_I) : bool = resolve_I (iter_Copied_I self)

meta "rewrite_def" function resolve_Copied_I

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Copied_I. inv_Copied_I self
    -> structural_resolve_Copied_I self
    -> structural_resolve_Copied_I self /\ (forall result: (). resolve_Copied_I self -> resolve_Copied_I self)
