use seq.Seq
use creusot.prelude.Any
use creusot.prelude.MutBorrow
use int.Int

type t_Item

type t_Self

type t_F

type t_MapInv_Self_F = { iter: t_Self; func: t_F; produced: Seq.seq t_Item }

function inv_Self (_1: t_Self) : bool

function inv_F (_1: t_F) : bool

function produces_Self (self: t_Self) (visited: Seq.seq t_Item) (o: t_Self) : bool

function inv_Item (_1: t_Item) : bool

type tup2_Item_Snapshot_Seq_Item = { f0: t_Item; f1: Seq.seq t_Item }

function precondition_F (self: t_F) (args: tup2_Item_Snapshot_Seq_Item) : bool

function completed_Self (self: MutBorrow.t t_Self) : bool

function next_precondition_Self [@inline:trivial] (iter'0: t_Self) (func'0: t_F) (produced'0: Seq.seq t_Item) : bool =
  forall e: t_Item, i: t_Self. inv_Item e /\ produces_Self iter'0 (Seq.singleton e) i
    -> precondition_F func'0 { f0 = e; f1 = produced'0 }

meta "rewrite_def" function next_precondition_Self

type t_B

function postcondition_once_F (self: t_F) (args: tup2_Item_Snapshot_Seq_Item) (result: t_B) : bool

function resolve_F (_1: t_F) : bool

function postcondition_mut_F (self: t_F) (args: tup2_Item_Snapshot_Seq_Item) (result_state: t_F) (result: t_B) : bool

function fn_mut_once_F (self: t_F) (args: tup2_Item_Snapshot_Seq_Item) (res: t_B) : ()

axiom fn_mut_once_F_spec:
  forall self: t_F, args: tup2_Item_Snapshot_Seq_Item, res: t_B [postcondition_once_F self args res]. postcondition_once_F self args res
    = (exists res_state: t_F. postcondition_mut_F self args res_state res /\ resolve_F res_state)

function hist_inv_F (self: t_F) (result_state: t_F) : bool

function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()

axiom hist_inv_trans_F_spec:
  forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
    -> hist_inv_F b c -> hist_inv_F self c

function hist_inv_refl_F (self: t_F) : ()

axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self

function postcondition_mut_hist_inv_F (self: t_F) (args: tup2_Item_Snapshot_Seq_Item) (res_state: t_F) (res: t_B) : ()

axiom postcondition_mut_hist_inv_F_spec:
  forall self: t_F, args: tup2_Item_Snapshot_Seq_Item, res_state: t_F, res: t_B [postcondition_mut_F self args res_state res | hist_inv_F self res_state]. postcondition_mut_F self args res_state res
    -> hist_inv_F self res_state

function invariant_ref_Item [@inline:trivial] (self: t_Item) : bool = inv_Item self

meta "rewrite_def" function invariant_ref_Item

function inv_ref_Item [@inline:trivial] (_1: t_Item) : bool = invariant_ref_Item _1

meta "rewrite_def" function inv_ref_Item

function invariant_Seq_Item [@inline:trivial] (self: Seq.seq t_Item) : bool = forall i: int. 0 <= i
      /\ i < Seq.length self -> inv_ref_Item (Seq.get self i)

meta "rewrite_def" function invariant_Seq_Item

function inv_Seq_Item [@inline:trivial] (_1: Seq.seq t_Item) : bool = invariant_Seq_Item _1

meta "rewrite_def" function inv_Seq_Item

function invariant_refmut_F [@inline:trivial] (self: MutBorrow.t t_F) : bool = inv_F self.current /\ inv_F self.final

meta "rewrite_def" function invariant_refmut_F

function inv_refmut_F [@inline:trivial] (_1: MutBorrow.t t_F) : bool = invariant_refmut_F _1

meta "rewrite_def" function inv_refmut_F

function preservation_Self [@inline:trivial] (iter'0: t_Self) (func'0: t_F) : bool =
  forall s: Seq.seq t_Item, e1: t_Item, e2: t_Item, f: MutBorrow.t t_F, b: t_B, i: t_Self. hist_inv_F func'0 f.current
    -> inv_Seq_Item s /\ inv_Item e1 /\ inv_Item e2 /\ inv_refmut_F f
    -> produces_Self iter'0 (Seq.snoc (Seq.snoc s e1) e2) i
    -> postcondition_mut_F f.current { f0 = e1; f1 = s } f.final b
    -> precondition_F f.final { f0 = e2; f1 = Seq.snoc s e1 }

meta "rewrite_def" function preservation_Self

constant reinitialize_Self: bool = forall iter'0: MutBorrow.t t_Self, func'0: t_F. completed_Self iter'0
  -> next_precondition_Self iter'0.final func'0 (Seq.empty: Seq.seq t_Item) /\ preservation_Self iter'0.final func'0

meta "rewrite_def" constant reinitialize_Self

function preservation_inv_Self (iter'0: t_Self) (func'0: t_F) (produced'0: Seq.seq t_Item) : bool

axiom preservation_inv_Self_spec:
  forall iter'0: t_Self, func'0: t_F, produced'0: Seq.seq t_Item [preservation_inv_Self iter'0 func'0 produced'0]. produced'0
      = (Seq.empty: Seq.seq t_Item) -> preservation_inv_Self iter'0 func'0 produced'0 = preservation_Self iter'0 func'0

function invariant_MapInv_Self_F (self: t_MapInv_Self_F) : bool = reinitialize_Self
  /\ preservation_inv_Self self.iter self.func self.produced /\ next_precondition_Self self.iter self.func self.produced

function inv_MapInv_Self_F (_1: t_MapInv_Self_F) : bool

axiom inv_axiom [@rewrite]: forall _1: t_MapInv_Self_F [inv_MapInv_Self_F _1]. inv_MapInv_Self_F _1
    = (invariant_MapInv_Self_F _1 /\ inv_Self _1.iter /\ inv_F _1.func)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let map_inv_Self (self: t_Self) (func'0: t_F) (return (x: t_MapInv_Self_F)) =
{[@stop_split] [@expl:map_inv_Self requires] ([@stop_split] [@expl:map_inv 'self' type invariant] inv_Self self)
  /\ ([@stop_split] [@expl:map_inv 'func' type invariant] inv_F func'0)
  /\ ([@stop_split] [@expl:map_inv requires #0] forall e: t_Item, i2: t_Self. produces_Self self (Seq.singleton e) i2
        /\ inv_Item e -> precondition_F func'0 { f0 = e; f1 = Seq.empty: Seq.seq t_Item })
  /\ ([@stop_split] [@expl:map_inv requires #1] reinitialize_Self)
  /\ ([@stop_split] [@expl:map_inv requires #2] preservation_Self self func'0)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_14 <- Seq.empty: Seq.seq t_Item ] s1
    | s1 = [ &_ret <- { iter = self; func = func'0; produced = _14 } ] s2
    | s2 = return {_ret} ] ]
  [ & _ret: t_MapInv_Self_F = Any.any_l ()
  | & self: t_Self = self
  | & func'0: t_F = func'0
  | & _14: Seq.seq t_Item = Any.any_l () ])
  [ return (result: t_MapInv_Self_F) ->
  {[@stop_split] [@expl:map_inv_Self ensures] ([@stop_split] [@expl:map_inv result type invariant] inv_MapInv_Self_F result)
    /\ ([@stop_split] [@expl:map_inv ensures] result
    = { iter = self; func = func'0; produced = Seq.empty: Seq.seq t_Item })}
    (! return {result}) ]
