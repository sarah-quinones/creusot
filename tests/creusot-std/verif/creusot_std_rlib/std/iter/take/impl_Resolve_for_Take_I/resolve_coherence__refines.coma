(* <std::iter::Take<I> as resolve::Resolve> *)

type t_Take_I

function inv_Take_I (_1: t_Take_I) : bool

function structural_resolve_Take_I (_1: t_Take_I) : bool

type t_I

function resolve_I (_1: t_I) : bool

function iter_Take_I (self: t_Take_I) : t_I

function resolve_Take_I [@inline:trivial] (self: t_Take_I) : bool = resolve_I (iter_Take_I self)

meta "rewrite_def" function resolve_Take_I

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Take_I. inv_Take_I self
    -> structural_resolve_Take_I self
    -> structural_resolve_Take_I self /\ (forall result: (). resolve_Take_I self -> resolve_Take_I self)
