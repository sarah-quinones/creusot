(* <F as std::ops::FnMutExt<Args>> *)

type t_F

type t_Args

type t_Output

function postcondition_mut_F (self: t_F) (args: t_Args) (result_state: t_F) (result: t_Output) : bool

function hist_inv_F (self: t_F) (result_state: t_F) : bool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_F, args: t_Args, res_state: t_F, res: t_Output. postcondition_mut_F self args res_state res
    -> postcondition_mut_F self args res_state res
    /\ (forall result: (). hist_inv_F self res_state -> hist_inv_F self res_state)
