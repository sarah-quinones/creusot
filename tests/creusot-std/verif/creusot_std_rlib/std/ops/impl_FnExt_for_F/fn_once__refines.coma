(* <F as std::ops::FnExt<Args>> *)

type t_F

type t_Args

type t_Output

function postcondition_once_F (self: t_F) (args: t_Args) (result: t_Output) : bool

function postcondition_F (self: t_F) (args: t_Args) (result: t_Output) : bool

function resolve_F (_1: t_F) : bool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_F, args: t_Args, res: t_Output. forall result: (). postcondition_once_F self args res
        = (postcondition_F self args res /\ resolve_F self)
      -> postcondition_once_F self args res = (postcondition_F self args res /\ resolve_F self)
