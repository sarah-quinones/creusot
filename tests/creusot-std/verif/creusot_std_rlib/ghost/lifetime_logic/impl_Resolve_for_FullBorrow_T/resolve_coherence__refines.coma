(* <ghost::lifetime_logic::FullBorrow<T> as resolve::Resolve> *)

type t_FullBorrow_T

type t_T

function inv_T (_1: t_T) : bool

function cur_T (self: t_FullBorrow_T) : t_T

function fin_FullBorrow_T (self: t_FullBorrow_T) : t_T

function invariant_FullBorrow_T [@inline:trivial] (self: t_FullBorrow_T) : bool = inv_T (cur_T self)
  /\ inv_T (fin_FullBorrow_T self)

meta "rewrite_def" function invariant_FullBorrow_T

function inv_FullBorrow_T (_1: t_FullBorrow_T) : bool

axiom inv_axiom [@rewrite]: forall _1: t_FullBorrow_T [inv_FullBorrow_T _1]. inv_FullBorrow_T _1
    = invariant_FullBorrow_T _1

function structural_resolve_FullBorrow_T (_1: t_FullBorrow_T) : bool

function resolve_FullBorrow_T (self: t_FullBorrow_T) : bool = cur_T self = fin_FullBorrow_T self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_FullBorrow_T. inv_FullBorrow_T self
    -> structural_resolve_FullBorrow_T self
    -> inv_FullBorrow_T self
    /\ structural_resolve_FullBorrow_T self
    /\ (forall result: (). resolve_FullBorrow_T self -> resolve_FullBorrow_T self)
