(* <ghost::shared::GhostShared<T> as std::ops::Deref> *)

use creusot.prelude.Any

type t_T

function resolve_T (_1: t_T) : bool

function inv_T (_1: t_T) : bool

function invariant_GhostShared_T (self: t_T) : bool = resolve_T self /\ inv_T self

function inv_GhostShared_T [@inline:trivial] (_1: t_T) : bool = invariant_GhostShared_T _1

meta "rewrite_def" function inv_GhostShared_T

function invariant_ref_T [@inline:trivial] (self: t_T) : bool = inv_T self

meta "rewrite_def" function invariant_ref_T

function inv_ref_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_T _1

meta "rewrite_def" function inv_ref_T

let to_ref_T (self: t_T) (return (x: t_T)) = {[@stop_split] [@expl:to_ref 'self' type invariant] inv_GhostShared_T self}
  any
  [ return (result: t_T) ->
  {[@stop_split] [@expl:to_ref_T ensures] ([@stop_split] [@expl:to_ref result type invariant] inv_ref_T result)
    /\ ([@stop_split] [@expl:to_ref ensures] result = self)}
    (! return {result}) ]

function invariant_ref_GhostShared_T [@inline:trivial] (self: t_T) : bool = inv_GhostShared_T self

meta "rewrite_def" function invariant_ref_GhostShared_T

function inv_ref_GhostShared_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_GhostShared_T _1

meta "rewrite_def" function inv_ref_GhostShared_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let deref_GhostShared_T (self: t_T) (return (x: t_T)) =
{[@stop_split] [@expl:deref 'self' type invariant] inv_ref_GhostShared_T self}
  (! bb0
  [ bb0 = s0
    [ s0 = to_ref_T {self} (fun (_x: t_T) -> [ &_4 <- _x ] s1) | s1 = [ &_ret <- _4 ] s2 | s2 = return {_ret} ] ]
  [ & _ret: t_T = Any.any_l () | & self: t_T = self | & _4: t_T = Any.any_l () ])
  [ return (result: t_T) ->
  {[@stop_split] [@expl:deref_GhostShared_T ensures] ([@stop_split] [@expl:deref result type invariant] inv_ref_T result)
    /\ ([@stop_split] [@expl:deref ensures] result = self)}
    (! return {result}) ]
