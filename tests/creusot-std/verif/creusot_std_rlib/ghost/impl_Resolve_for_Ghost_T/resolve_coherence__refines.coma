(* <ghost::Ghost<T> as resolve::Resolve> *)

type t_T

function inv_T (_1: t_T) : bool

function invariant_Ghost_T [@inline:trivial] (self: t_T) : bool = inv_T self

meta "rewrite_def" function invariant_Ghost_T

function inv_Ghost_T [@inline:trivial] (_1: t_T) : bool = invariant_Ghost_T _1

meta "rewrite_def" function inv_Ghost_T

function structural_resolve_Ghost_T (_1: t_T) : bool

function resolve_T (_1: t_T) : bool

function resolve_Ghost_T [@inline:trivial] (self: t_T) : bool = resolve_T self

meta "rewrite_def" function resolve_Ghost_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_T. inv_Ghost_T self
    -> structural_resolve_Ghost_T self
    -> structural_resolve_Ghost_T self /\ (forall result: (). resolve_Ghost_T self -> resolve_Ghost_T self)
