(* <ghost::perm::Perm<C> as resolve::Resolve> *)

type t_Perm_C

function inv_Perm_C (_1: t_Perm_C) : bool

function structural_resolve_Perm_C (_1: t_Perm_C) : bool

type t_Value

function resolve_ref_Value [@inline:trivial] (_1: t_Value) : bool = true

meta "rewrite_def" function resolve_ref_Value

function val_unsized_C (self: t_Perm_C) : t_Value

function resolve_Perm_C [@inline:trivial] (self: t_Perm_C) : bool = resolve_ref_Value (val_unsized_C self)

meta "rewrite_def" function resolve_Perm_C

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Perm_C. inv_Perm_C self
    -> structural_resolve_Perm_C self
    -> inv_Perm_C self
    /\ structural_resolve_Perm_C self /\ (forall result: (). resolve_Perm_C self -> resolve_Perm_C self)
