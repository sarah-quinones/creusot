(* <ghost::Ghost<T> as std::clone::Clone> *)

type t_T

function inv_T (_1: t_T) : bool

function invariant_Ghost_T [@inline:trivial] (self: t_T) : bool = inv_T self

meta "rewrite_def" function invariant_Ghost_T

function inv_Ghost_T [@inline:trivial] (_1: t_T) : bool = invariant_Ghost_T _1

meta "rewrite_def" function inv_Ghost_T

function invariant_ref_Ghost_T [@inline:trivial] (self: t_T) : bool = inv_Ghost_T self

meta "rewrite_def" function invariant_ref_Ghost_T

function inv_ref_Ghost_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_Ghost_T _1

meta "rewrite_def" function inv_ref_Ghost_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_T. inv_ref_Ghost_T self
    -> inv_ref_Ghost_T self /\ (forall result: t_T. inv_Ghost_T result /\ result = self -> inv_Ghost_T result)
