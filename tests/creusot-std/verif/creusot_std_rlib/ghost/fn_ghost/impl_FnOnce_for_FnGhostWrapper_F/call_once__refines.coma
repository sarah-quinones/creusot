(* <ghost::fn_ghost::FnGhostWrapper<F> as std::ops::FnOnce<I>> *)

type t_F

type t_FnGhostWrapper_F = { f0: t_F }

type t_I

function inv_F (_1: t_F) : bool

function inv_FnGhostWrapper_F (_1: t_FnGhostWrapper_F) : bool

axiom inv_axiom [@rewrite]: forall _1: t_FnGhostWrapper_F [inv_FnGhostWrapper_F _1]. inv_FnGhostWrapper_F _1
    = inv_F _1.f0

function inv_I (_1: t_I) : bool

function precondition_F (self: t_F) (args: t_I) : bool

function precondition_FnGhostWrapper_F (self: t_FnGhostWrapper_F) (args: t_I) : bool = precondition_F self.f0 args

meta "rewrite_def" function precondition_FnGhostWrapper_F

type t_Output

function inv_Output (_1: t_Output) : bool

function postcondition_once_F (self: t_F) (args: t_I) (result: t_Output) : bool

function postcondition_once_FnGhostWrapper_F (self: t_FnGhostWrapper_F) (args: t_I) (result: t_Output) : bool =
  postcondition_once_F self.f0 args result

meta "rewrite_def" function postcondition_once_FnGhostWrapper_F

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_FnGhostWrapper_F, args: t_I. inv_FnGhostWrapper_F self
    -> inv_I args
    -> precondition_FnGhostWrapper_F self args
    -> inv_FnGhostWrapper_F self
    /\ inv_I args
    /\ precondition_FnGhostWrapper_F self args
    /\ (forall result: t_Output. inv_Output result /\ postcondition_once_FnGhostWrapper_F self args result
      -> inv_Output result /\ postcondition_once_FnGhostWrapper_F self args result)
