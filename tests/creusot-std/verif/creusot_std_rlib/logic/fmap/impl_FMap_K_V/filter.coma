(* logic::fmap::FMap<K, V> *)

use map.Map

type t_FMap_K_V

type t_K

type t_V

type tup2_K_V = { f0: t_K; f1: t_V }

type t_Option_V = None | Some t_V

function to_mapping_K (self: t_FMap_K_V) : Map.map t_K t_Option_V

function lookup_K [@inline:trivial] (self: t_FMap_K_V) (k: t_K) : t_Option_V = Map.get (to_mapping_K self) k

meta "rewrite_def" function lookup_K

function index_Mapping_tup2_K_V_bool [@inline:trivial] (self: Map.map tup2_K_V bool) (a: tup2_K_V) : bool =
  Map.get self a

meta "rewrite_def" function index_Mapping_tup2_K_V_bool

function index_Mapping_tup2_K_V_Option_V [@inline:trivial] (self: Map.map tup2_K_V t_Option_V) (a: tup2_K_V) : t_Option_V
 = Map.get self a

meta "rewrite_def" function index_Mapping_tup2_K_V_Option_V

function filter_map_K (self: t_FMap_K_V) (f: Map.map tup2_K_V t_Option_V) : t_FMap_K_V

axiom filter_map_K_spec:
  forall self: t_FMap_K_V, f: Map.map tup2_K_V t_Option_V [filter_map_K self f]. forall k: t_K [lookup_K (filter_map_K self f) k]. lookup_K (filter_map_K self f) k
      = match lookup_K self k with
        | None -> None
        | Some v -> index_Mapping_tup2_K_V_Option_V f { f0 = k; f1 = v }
        end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_FMap_K_V

constant p : Map.map tup2_K_V bool

function filter_K (self: t_FMap_K_V) (p: Map.map tup2_K_V bool) : t_FMap_K_V

goal vc_filter_K: (forall _0: tup2_K_V. forall local. local = _0 -> true)
  /\ (forall f: Map.map tup2_K_V t_Option_V. (forall _0: tup2_K_V [Map.get f _0]. exists local. local = _0
          /\ (let {f0 = k; f1 = v} = local in if index_Mapping_tup2_K_V_bool p { f0 = k; f1 = v } then
            Some v = Map.get f _0
          else
            None = Map.get f _0
          ))
    -> ([@stop_split] [@expl:filter_map ensures] forall k: t_K [lookup_K (filter_map_K self f) k]. lookup_K (filter_map_K self f) k
        = match lookup_K self k with
          | None -> None
          | Some v -> index_Mapping_tup2_K_V_Option_V f { f0 = k; f1 = v }
          end)
    -> (let result = filter_map_K self f in [@stop_split] [@expl:filter ensures] forall k: t_K [lookup_K result k]. lookup_K result k
      = match lookup_K self k with
        | None -> None
        | Some v -> if index_Mapping_tup2_K_V_bool p { f0 = k; f1 = v } then Some v else None
        end))
