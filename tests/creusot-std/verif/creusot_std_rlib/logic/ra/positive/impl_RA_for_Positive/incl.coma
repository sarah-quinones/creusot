(* <logic::int::Positive as logic::ra::RA> *)

use int.Int

type t_Positive

type t_Option_Positive = None | Some t_Positive

function gt_log_Int [@inline:trivial] (self: int) (other: int) : bool = other < self

meta "rewrite_def" function gt_log_Int

function to_int (self: t_Positive) : int

axiom to_int_spec: forall self: t_Positive [to_int self]. gt_log_Int (to_int self) 0

function view_Positive (self: t_Positive) : int = to_int self

function add_Positive (self: t_Positive) (other: t_Positive) : t_Positive

axiom add_Positive_spec:
  forall self: t_Positive, other: t_Positive [add_Positive self other]. view_Positive (add_Positive self other)
    = view_Positive self + view_Positive other

function op_Positive (self: t_Positive) (other: t_Positive) : t_Option_Positive = Some (add_Positive self other)

function ext_eq (self: t_Positive) (other: t_Positive) : bool = to_int self = to_int other

axiom ext_eq_spec: forall self: t_Positive, other: t_Positive [self = other]. ext_eq self other = (self = other)

function le_log_Positive (self: t_Positive) (other: t_Positive) : bool = to_int self <= to_int other

function lt_log_Positive (self: t_Positive) (other: t_Positive) : bool = to_int self < to_int other

function le_lt_log_Positive (self: t_Positive) (other: t_Positive) : ()

axiom le_lt_log_Positive_spec: forall self: t_Positive, other: t_Positive. le_log_Positive self other
    = (lt_log_Positive self other \/ self = other)

function new (n: int) : t_Positive

axiom new_spec: forall n: int [new n]. gt_log_Int n 0 -> to_int (new n) = n

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Positive

constant other : t_Positive

function incl_Positive (self: t_Positive) (other: t_Positive) : bool

goal vc_incl_Positive: forall local. local = ()
    -> (forall r. r = lt_log_Positive self other
      -> (let r = r in if r then
        ([@stop_split] [@expl:new requires] gt_log_Int (view_Positive other - view_Positive self) 0)
        /\ (([@stop_split] [@expl:new ensures] to_int (new (view_Positive other - view_Positive self))
          = view_Positive other - view_Positive self)
        -> op_Positive self (new (view_Positive other - view_Positive self)) = Some other
        && (forall local'0. local'0 = ()
          -> (forall local'1. local'1 = ()
            -> ([@stop_split] [@expl:incl ensures] r
            = (exists factor: t_Positive. op_Positive self factor = Some other)))))
      else
        forall local'0. local'0 = ()
          -> (forall local'1. local'1 = ()
            -> ([@stop_split] [@expl:incl ensures] r
            = (exists factor: t_Positive. op_Positive self factor = Some other)))
      ))
