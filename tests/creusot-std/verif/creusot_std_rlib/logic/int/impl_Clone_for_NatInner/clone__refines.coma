(* <logic::int::NatInner as std::clone::Clone> *)

use int.Int

type t_NatInner = { f0: int }

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

function invariant_NatInner (self: t_NatInner) : bool = ge_log_Int self.f0 0

function inv_NatInner (_1: t_NatInner) : bool

axiom inv_axiom [@rewrite]: forall _1: t_NatInner [inv_NatInner _1]. inv_NatInner _1 = invariant_NatInner _1

function invariant_ref_NatInner [@inline:trivial] (self: t_NatInner) : bool = inv_NatInner self

meta "rewrite_def" function invariant_ref_NatInner

function inv_ref_NatInner [@inline:trivial] (_1: t_NatInner) : bool = invariant_ref_NatInner _1

meta "rewrite_def" function inv_ref_NatInner

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_NatInner. inv_ref_NatInner self
    -> inv_ref_NatInner self /\ (forall result: t_NatInner. inv_NatInner result /\ result = self -> inv_NatInner result)
