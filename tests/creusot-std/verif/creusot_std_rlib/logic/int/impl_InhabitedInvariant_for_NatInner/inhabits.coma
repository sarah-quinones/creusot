(* <logic::int::NatInner as invariant::subset::InhabitedInvariant> *)

use int.Int

type t_NatInner = { f0: int }

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

function invariant_NatInner (self: t_NatInner) : bool = ge_log_Int self.f0 0

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

function inhabits_NatInner : t_NatInner

goal vc_inhabits_NatInner: [@stop_split] [@expl:inhabits ensures] invariant_NatInner { f0 = 0 }
