(* <logic::int::PositiveInner as std::clone::Clone> *)

use creusot.prelude.Any
use int.Int

type t_PositiveInner = { f0: int }

function gt_log_Int [@inline:trivial] (self: int) (other: int) : bool = other < self

meta "rewrite_def" function gt_log_Int

function invariant_PositiveInner (self: t_PositiveInner) : bool = gt_log_Int self.f0 0

function inv_PositiveInner (_1: t_PositiveInner) : bool

axiom inv_axiom [@rewrite]: forall _1: t_PositiveInner [inv_PositiveInner _1]. inv_PositiveInner _1
    = invariant_PositiveInner _1

function invariant_ref_PositiveInner [@inline:trivial] (self: t_PositiveInner) : bool = inv_PositiveInner self

meta "rewrite_def" function invariant_ref_PositiveInner

function inv_ref_PositiveInner [@inline:trivial] (_1: t_PositiveInner) : bool = invariant_ref_PositiveInner _1

meta "rewrite_def" function inv_ref_PositiveInner

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_PositiveInner (self: t_PositiveInner) (return (x: t_PositiveInner)) =
{[@stop_split] [@expl:clone 'self' type invariant] inv_ref_PositiveInner self}
  (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_PositiveInner = Any.any_l () | & self: t_PositiveInner = self ])
  [ return (result: t_PositiveInner) ->
  {[@stop_split] [@expl:clone_PositiveInner ensures] ([@stop_split] [@expl:clone result type invariant] inv_PositiveInner result)
    /\ ([@stop_split] [@expl:clone ensures] result = self)}
    (! return {result}) ]
