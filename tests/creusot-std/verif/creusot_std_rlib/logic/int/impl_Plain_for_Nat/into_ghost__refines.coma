(* <logic::int::Nat as ghost::Plain> *)

type t_Subset_NatInner

type t_Nat = { f0: t_Subset_NatInner }

function inv_Nat [@inline:trivial] (_1: t_Nat) : bool = true

meta "rewrite_def" function inv_Nat

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: t_Nat. inv_Nat snap -> (forall result: t_Nat. result = snap -> result = snap)
