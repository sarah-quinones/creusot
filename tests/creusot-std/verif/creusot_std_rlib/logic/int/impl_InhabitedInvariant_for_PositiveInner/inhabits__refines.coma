(* <logic::int::PositiveInner as invariant::subset::InhabitedInvariant> *)

use int.Int

type t_PositiveInner = { f0: int }

function gt_log_Int [@inline:trivial] (self: int) (other: int) : bool = other < self

meta "rewrite_def" function gt_log_Int

function invariant_PositiveInner (self: t_PositiveInner) : bool = gt_log_Int self.f0 0

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall result: t_PositiveInner. invariant_PositiveInner result -> invariant_PositiveInner result
