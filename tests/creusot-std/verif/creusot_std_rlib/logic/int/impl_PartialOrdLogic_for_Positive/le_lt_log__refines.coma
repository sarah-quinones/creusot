(* <logic::int::Positive as logic::ord::PartialOrdLogic> *)

use int.Int

type t_Subset_PositiveInner

type t_Positive = { f0: t_Subset_PositiveInner }

function gt_log_Int [@inline:trivial] (self: int) (other: int) : bool = other < self

meta "rewrite_def" function gt_log_Int

type t_PositiveInner = { f0'0: int }

function invariant_PositiveInner (self: t_PositiveInner) : bool = gt_log_Int self.f0'0 0

function inner_PositiveInner (self: t_Subset_PositiveInner) : t_PositiveInner

axiom inner_PositiveInner_spec:
  forall self: t_Subset_PositiveInner [inner_PositiveInner self]. invariant_PositiveInner (inner_PositiveInner self)

function to_int (self: t_Positive) : int = (inner_PositiveInner self.f0).f0'0

axiom to_int_spec: forall self: t_Positive [to_int self]. gt_log_Int (to_int self) 0

function le_log_Positive (self: t_Positive) (other: t_Positive) : bool = to_int self <= to_int other

function lt_log_Positive (self: t_Positive) (other: t_Positive) : bool = to_int self < to_int other

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Positive, other: t_Positive. forall result: (). le_log_Positive self other
        = (lt_log_Positive self other \/ self = other)
      -> le_log_Positive self other = (lt_log_Positive self other \/ self = other)
