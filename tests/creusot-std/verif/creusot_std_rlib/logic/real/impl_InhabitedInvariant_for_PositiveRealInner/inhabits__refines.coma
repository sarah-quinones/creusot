(* <logic::real::PositiveRealInner as invariant::subset::InhabitedInvariant> *)

use real.Real
use real.FromInt

type t_PositiveRealInner = { f0: Real.real }

function gt_log_Real [@inline:trivial] (self: Real.real) (other: Real.real) : bool = Real.(<) other self

meta "rewrite_def" function gt_log_Real

function invariant_PositiveRealInner (self: t_PositiveRealInner) : bool = gt_log_Real self.f0 (FromInt.from_int 0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall result: t_PositiveRealInner. invariant_PositiveRealInner result
    -> invariant_PositiveRealInner result
