(* <logic::id::Id as ghost::Plain> *)

type t_Id

function inv_Id [@inline:trivial] (_1: t_Id) : bool = true

meta "rewrite_def" function inv_Id

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: t_Id. inv_Id snap -> (forall result: t_Id. result = snap -> result = snap)
