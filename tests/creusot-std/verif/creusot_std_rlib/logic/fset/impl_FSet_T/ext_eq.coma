(* logic::fset::FSet<T> *)

use set.Fset

type t_T

function contains_T [@inline:trivial] (self: Fset.fset t_T) (e: t_T) : bool = Fset.mem e self

meta "rewrite_def" function contains_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Fset.fset t_T

constant other : Fset.fset t_T

function ext_eq_T (self: Fset.fset t_T) (other: Fset.fset t_T) : bool

goal vc_ext_eq_T: [@stop_split] [@expl:ext_eq ensures] (forall e: t_T. contains_T self e = contains_T other e)
  = (self = other)
