(* <logic::fset::FSet<T> as resolve::Resolve> *)

use set.Fset

type t_T

function contains_T [@inline:trivial] (self: Fset.fset t_T) (e: t_T) : bool = Fset.mem e self

meta "rewrite_def" function contains_T

function inv_T (_1: t_T) : bool

function invariant_FSet_T [@inline:trivial] (self: Fset.fset t_T) : bool = forall x: t_T. contains_T self x -> inv_T x

meta "rewrite_def" function invariant_FSet_T

function inv_FSet_T [@inline:trivial] (_1: Fset.fset t_T) : bool = invariant_FSet_T _1

meta "rewrite_def" function inv_FSet_T

function structural_resolve_FSet_T (_1: Fset.fset t_T) : bool

function resolve_T (_1: t_T) : bool

function resolve_FSet_T (self: Fset.fset t_T) : bool = forall x: t_T. contains_T self x -> resolve_T x

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Fset.fset t_T. inv_FSet_T self
    -> structural_resolve_FSet_T self
    -> structural_resolve_FSet_T self /\ (forall result: (). resolve_FSet_T self -> resolve_FSet_T self)
