(* <logic::seq::Iter<T> as resolve::Resolve> *)

use seq.Seq
use int.Int

type t_T

type t_Iter_T = { f0: Seq.seq t_T }

function inv_T (_1: t_T) : bool

function invariant_ref_T [@inline:trivial] (self: t_T) : bool = inv_T self

meta "rewrite_def" function invariant_ref_T

function inv_ref_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_T _1

meta "rewrite_def" function inv_ref_T

function invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) : bool = forall i: int. 0 <= i /\ i < Seq.length self
    -> inv_ref_T (Seq.get self i)

meta "rewrite_def" function invariant_Seq_T

function inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) : bool = invariant_Seq_T _1

meta "rewrite_def" function inv_Seq_T

function inv_Iter_T (_1: t_Iter_T) : bool

axiom inv_axiom [@rewrite]: forall _1: t_Iter_T [inv_Iter_T _1]. inv_Iter_T _1 = inv_Seq_T _1.f0

function resolve_T (_1: t_T) : bool

function resolve_Seq_T (self: Seq.seq t_T) : bool = forall i: int. 0 <= i /\ i < Seq.length self
    -> resolve_T (Seq.get self i)

function resolve_Seq_T'0 [@inline:trivial] (_1: Seq.seq t_T) : bool = resolve_Seq_T _1

meta "rewrite_def" function resolve_Seq_T'0

function structural_resolve_Iter_T (_1: t_Iter_T) : bool = resolve_Seq_T'0 _1.f0

function view_Iter_T (self: t_Iter_T) : Seq.seq t_T = self.f0

function resolve_Iter_T [@inline:trivial] (self: t_Iter_T) : bool = resolve_Seq_T'0 (view_Iter_T self)

meta "rewrite_def" function resolve_Iter_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Iter_T. inv_Iter_T self
    -> structural_resolve_Iter_T self
    -> structural_resolve_Iter_T self /\ (forall result: (). resolve_Iter_T self -> resolve_Iter_T self)
