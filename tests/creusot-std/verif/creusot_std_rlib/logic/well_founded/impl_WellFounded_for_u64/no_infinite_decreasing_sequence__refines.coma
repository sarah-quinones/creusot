(* <u64 as logic::well_founded::WellFounded> *)

use creusot.int.UInt64
use map.Map
use int.Int

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

function gt_log_u64 [@inline:trivial] (self: UInt64.t) (other: UInt64.t) : bool = UInt64.lt other self

meta "rewrite_def" function gt_log_u64

function well_founded_relation_u64 [@inline:trivial] (self: UInt64.t) (other: UInt64.t) : bool = gt_log_u64 self other

meta "rewrite_def" function well_founded_relation_u64

function index_Mapping_Int_u64 [@inline:trivial] (self: Map.map int UInt64.t) (a: int) : UInt64.t = Map.get self a

meta "rewrite_def" function index_Mapping_Int_u64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall s: Map.map int UInt64.t. forall result: int. ge_log_Int result 0
        /\ not well_founded_relation_u64 (index_Mapping_Int_u64 s result) (index_Mapping_Int_u64 s (result + 1))
      -> ge_log_Int result 0
      /\ not well_founded_relation_u64 (index_Mapping_Int_u64 s result) (index_Mapping_Int_u64 s (result + 1))
