(* <u16 as logic::well_founded::WellFounded> *)

use creusot.int.UInt16
use map.Map
use int.Int

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

function gt_log_u16 [@inline:trivial] (self: UInt16.t) (other: UInt16.t) : bool = UInt16.lt other self

meta "rewrite_def" function gt_log_u16

function well_founded_relation_u16 [@inline:trivial] (self: UInt16.t) (other: UInt16.t) : bool = gt_log_u16 self other

meta "rewrite_def" function well_founded_relation_u16

function index_Mapping_Int_u16 [@inline:trivial] (self: Map.map int UInt16.t) (a: int) : UInt16.t = Map.get self a

meta "rewrite_def" function index_Mapping_Int_u16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall s: Map.map int UInt16.t. forall result: int. ge_log_Int result 0
        /\ not well_founded_relation_u16 (index_Mapping_Int_u16 s result) (index_Mapping_Int_u16 s (result + 1))
      -> ge_log_Int result 0
      /\ not well_founded_relation_u16 (index_Mapping_Int_u16 s result) (index_Mapping_Int_u16 s (result + 1))
