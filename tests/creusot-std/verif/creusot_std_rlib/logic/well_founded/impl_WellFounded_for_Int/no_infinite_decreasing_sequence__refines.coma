(* <logic::int::Int as logic::well_founded::WellFounded> *)

use map.Map
use int.Int

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

function gt_log_Int [@inline:trivial] (self: int) (other: int) : bool = other < self

meta "rewrite_def" function gt_log_Int

function well_founded_relation_Int [@inline:trivial] (self: int) (other: int) : bool = ge_log_Int self 0
  /\ gt_log_Int self other

meta "rewrite_def" function well_founded_relation_Int

function index_Mapping_Int_Int [@inline:trivial] (self: Map.map int int) (a: int) : int = Map.get self a

meta "rewrite_def" function index_Mapping_Int_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall s: Map.map int int. forall result: int. ge_log_Int result 0
        /\ not well_founded_relation_Int (index_Mapping_Int_Int s result) (index_Mapping_Int_Int s (result + 1))
      -> ge_log_Int result 0
      /\ not well_founded_relation_Int (index_Mapping_Int_Int s result) (index_Mapping_Int_Int s (result + 1))
