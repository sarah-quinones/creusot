(* <i8 as logic::well_founded::WellFounded> *)

use creusot.int.Int8
use map.Map
use int.Int

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

function gt_log_i8 [@inline:trivial] (self: Int8.t) (other: Int8.t) : bool = Int8.lt other self

meta "rewrite_def" function gt_log_i8

function well_founded_relation_i8 [@inline:trivial] (self: Int8.t) (other: Int8.t) : bool = gt_log_i8 self other

meta "rewrite_def" function well_founded_relation_i8

function index_Mapping_Int_i8 [@inline:trivial] (self: Map.map int Int8.t) (a: int) : Int8.t = Map.get self a

meta "rewrite_def" function index_Mapping_Int_i8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall s: Map.map int Int8.t. forall result: int. ge_log_Int result 0
        /\ not well_founded_relation_i8 (index_Mapping_Int_i8 s result) (index_Mapping_Int_i8 s (result + 1))
      -> ge_log_Int result 0
      /\ not well_founded_relation_i8 (index_Mapping_Int_i8 s result) (index_Mapping_Int_i8 s (result + 1))
