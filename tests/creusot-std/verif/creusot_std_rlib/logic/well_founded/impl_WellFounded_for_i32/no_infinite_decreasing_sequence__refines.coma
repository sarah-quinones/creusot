(* <i32 as logic::well_founded::WellFounded> *)

use creusot.int.Int32
use map.Map
use int.Int

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

function gt_log_i32 [@inline:trivial] (self: Int32.t) (other: Int32.t) : bool = Int32.lt other self

meta "rewrite_def" function gt_log_i32

function well_founded_relation_i32 [@inline:trivial] (self: Int32.t) (other: Int32.t) : bool = gt_log_i32 self other

meta "rewrite_def" function well_founded_relation_i32

function index_Mapping_Int_i32 [@inline:trivial] (self: Map.map int Int32.t) (a: int) : Int32.t = Map.get self a

meta "rewrite_def" function index_Mapping_Int_i32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall s: Map.map int Int32.t. forall result: int. ge_log_Int result 0
        /\ not well_founded_relation_i32 (index_Mapping_Int_i32 s result) (index_Mapping_Int_i32 s (result + 1))
      -> ge_log_Int result 0
      /\ not well_founded_relation_i32 (index_Mapping_Int_i32 s result) (index_Mapping_Int_i32 s (result + 1))
