(* <isize as logic::well_founded::WellFounded> *)

use creusot.int.Int64
use map.Map
use int.Int

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

function gt_log_isize [@inline:trivial] (self: Int64.t) (other: Int64.t) : bool = Int64.lt other self

meta "rewrite_def" function gt_log_isize

function well_founded_relation_isize [@inline:trivial] (self: Int64.t) (other: Int64.t) : bool = gt_log_isize self other

meta "rewrite_def" function well_founded_relation_isize

function index_Mapping_Int_isize [@inline:trivial] (self: Map.map int Int64.t) (a: int) : Int64.t = Map.get self a

meta "rewrite_def" function index_Mapping_Int_isize

constant const_MIN: Int64.t = (-9223372036854775808: Int64.t)

function gt_log_Int [@inline:trivial] (self: int) (other: int) : bool = other < self

meta "rewrite_def" function gt_log_Int

function well_founded_relation_Int [@inline:trivial] (self: int) (other: int) : bool = ge_log_Int self 0
  /\ gt_log_Int self other

meta "rewrite_def" function well_founded_relation_Int

function index_Mapping_Int_Int [@inline:trivial] (self: Map.map int int) (a: int) : int = Map.get self a

meta "rewrite_def" function index_Mapping_Int_Int

function no_infinite_decreasing_sequence_Int (s: Map.map int int) : int

axiom no_infinite_decreasing_sequence_Int_spec:
  forall s: Map.map int int [no_infinite_decreasing_sequence_Int s]. ge_log_Int (no_infinite_decreasing_sequence_Int s) 0

axiom no_infinite_decreasing_sequence_Int_spec'0:
  forall s: Map.map int int [no_infinite_decreasing_sequence_Int s]. not well_founded_relation_Int (index_Mapping_Int_Int s (no_infinite_decreasing_sequence_Int s)) (index_Mapping_Int_Int s (no_infinite_decreasing_sequence_Int s
    + 1))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Map.map int Int64.t

function no_infinite_decreasing_sequence_isize (s: Map.map int Int64.t) : int

goal vc_no_infinite_decreasing_sequence_isize:
  forall f: Map.map int int. (forall i: int [Map.get f i]. Int64.to_int (index_Mapping_Int_isize s i)
          - Int64.to_int const_MIN
        = Map.get f i)
    -> ([@stop_split] [@expl:no_infinite_decreasing_sequence ensures] ([@stop_split] [@expl:no_infinite_decreasing_sequence ensures #0] ge_log_Int (no_infinite_decreasing_sequence_Int f) 0)
      /\ ([@stop_split] [@expl:no_infinite_decreasing_sequence ensures #1] not well_founded_relation_Int (index_Mapping_Int_Int f (no_infinite_decreasing_sequence_Int f)) (index_Mapping_Int_Int f (no_infinite_decreasing_sequence_Int f
      + 1))))
    -> (let result = no_infinite_decreasing_sequence_Int f in [@stop_split] [@expl:no_infinite_decreasing_sequence_isize ensures] ([@stop_split] [@expl:no_infinite_decreasing_sequence ensures #0] ge_log_Int result 0)
    /\ ([@stop_split] [@expl:no_infinite_decreasing_sequence ensures #1] not well_founded_relation_isize (index_Mapping_Int_isize s result) (index_Mapping_Int_isize s (result
    + 1))))
