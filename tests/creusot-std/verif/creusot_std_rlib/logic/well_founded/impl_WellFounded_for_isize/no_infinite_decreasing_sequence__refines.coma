(* <isize as logic::well_founded::WellFounded> *)

use creusot.int.Int64
use map.Map
use int.Int

function ge_log_Int [@inline:trivial] (self: int) (other: int) : bool = other <= self

meta "rewrite_def" function ge_log_Int

function gt_log_isize [@inline:trivial] (self: Int64.t) (other: Int64.t) : bool = Int64.lt other self

meta "rewrite_def" function gt_log_isize

function well_founded_relation_isize [@inline:trivial] (self: Int64.t) (other: Int64.t) : bool = gt_log_isize self other

meta "rewrite_def" function well_founded_relation_isize

function index_Mapping_Int_isize [@inline:trivial] (self: Map.map int Int64.t) (a: int) : Int64.t = Map.get self a

meta "rewrite_def" function index_Mapping_Int_isize

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall s: Map.map int Int64.t. forall result: int. ge_log_Int result 0
        /\ not well_founded_relation_isize (index_Mapping_Int_isize s result) (index_Mapping_Int_isize s (result + 1))
      -> ge_log_Int result 0
      /\ not well_founded_relation_isize (index_Mapping_Int_isize s result) (index_Mapping_Int_isize s (result + 1))
