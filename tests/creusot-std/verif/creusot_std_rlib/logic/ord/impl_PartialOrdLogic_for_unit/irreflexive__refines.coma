(* <() as logic::ord::PartialOrdLogic> *)

function lt_log_unit [@inline:trivial] (self: ()) (_2: ()) : bool = false

meta "rewrite_def" function lt_log_unit

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: (). forall result: (). not lt_log_unit self self -> not lt_log_unit self self
