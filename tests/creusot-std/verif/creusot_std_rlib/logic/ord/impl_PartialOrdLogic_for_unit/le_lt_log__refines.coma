(* <() as logic::ord::PartialOrdLogic> *)

function le_log_unit [@inline:trivial] (self: ()) (_2: ()) : bool = true

meta "rewrite_def" function le_log_unit

function lt_log_unit [@inline:trivial] (self: ()) (_2: ()) : bool = false

meta "rewrite_def" function lt_log_unit

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: (), other: (). forall result: (). le_log_unit self other
        = (lt_log_unit self other \/ self = other) -> le_log_unit self other = (lt_log_unit self other \/ self = other)
