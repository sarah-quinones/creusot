(* <invariant::subset::Subset<T> as resolve::Resolve> *)

type t_Subset_T

function inv_Subset_T [@inline:trivial] (_1: t_Subset_T) : bool = true

meta "rewrite_def" function inv_Subset_T

function structural_resolve_Subset_T (_1: t_Subset_T) : bool

type t_T

function resolve_T (_1: t_T) : bool

function invariant_T (self: t_T) : bool

function inner_T (self: t_Subset_T) : t_T

axiom inner_T_spec: forall self: t_Subset_T [inner_T self]. invariant_T (inner_T self)

function resolve_Subset_T [@inline:trivial] (self: t_Subset_T) : bool = resolve_T (inner_T self)

meta "rewrite_def" function resolve_Subset_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Subset_T. inv_Subset_T self
    -> structural_resolve_Subset_T self
    -> structural_resolve_Subset_T self /\ (forall result: (). resolve_Subset_T self -> resolve_Subset_T self)
