module M_trait_A__is_true
  use int.Int
  
  constant mktrue_Self : int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  function is_true_Self : ()
  
  goal vc_is_true_Self: [@stop_split] [@expl:is_true ensures] mktrue_Self <= 10
end
module M_uses_invariant
  use creusot.prelude.MutBorrow
  use creusot.prelude.Any
  
  type t_T
  
  type t_Option_T = None | Some t_T
  
  type t_Once_T = { f0: t_Option_T }
  
  function inv_T (_1: t_T) : bool
  
  function inv_Option_T (_1: t_Option_T) : bool
  
  axiom inv_axiom [@rewrite]: forall _1: t_Option_T [inv_Option_T _1]. inv_Option_T _1
      = match _1 with
        | None -> true
        | Some f0'0 -> inv_T f0'0
        end
  
  function invariant_refmut_Option_T [@inline:trivial] (self: MutBorrow.t t_Option_T) : bool = inv_Option_T self.current
    /\ inv_Option_T self.final
  
  meta "rewrite_def" function invariant_refmut_Option_T
  
  function inv_refmut_Option_T [@inline:trivial] (_1: MutBorrow.t t_Option_T) : bool = invariant_refmut_Option_T _1
  
  meta "rewrite_def" function inv_refmut_Option_T
  
  let take_T (self: MutBorrow.t t_Option_T) (return (x: t_Option_T)) =
  {[@stop_split] [@expl:take 'self' type invariant] inv_refmut_Option_T self}
    any
    [ return (result: t_Option_T) ->
    {[@stop_split] [@expl:take_T ensures] ([@stop_split] [@expl:take result type invariant] inv_Option_T result)
      /\ ([@stop_split] [@expl:take ensures] result = self.current /\ self.final = None)}
      (! return {result}) ]
  
  function resolve_T (_1: t_T) : bool
  
  function resolve_Option_T (_1: t_Option_T) : bool
  
  axiom resolve_axiom [@rewrite]: forall _1: t_Option_T [resolve_Option_T _1]. resolve_Option_T _1
      = match _1 with
        | None -> true
        | Some x0 -> resolve_T x0
        end
  
  function inv_Once_T (_1: t_Once_T) : bool
  
  axiom inv_axiom'0 [@rewrite]: forall _1: t_Once_T [inv_Once_T _1]. inv_Once_T _1 = inv_Option_T _1.f0
  
  function invariant_refmut_Once_T [@inline:trivial] (self: MutBorrow.t t_Once_T) : bool = inv_Once_T self.current
    /\ inv_Once_T self.final
  
  meta "rewrite_def" function invariant_refmut_Once_T
  
  function inv_refmut_Once_T [@inline:trivial] (_1: MutBorrow.t t_Once_T) : bool = invariant_refmut_Once_T _1
  
  meta "rewrite_def" function inv_refmut_Once_T
  
  function resolve_refmut_Once_T [@inline:trivial] (_1: MutBorrow.t t_Once_T) : bool = _1.final = _1.current
  
  meta "rewrite_def" function resolve_refmut_Once_T
  
  function invariant_Once_T (self: t_Once_T) : bool = true
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let uses_invariant_T (x: MutBorrow.t t_Once_T) (return (x'0: ())) =
  {[@stop_split] [@expl:uses_invariant_T requires] ([@stop_split] [@expl:uses_invariant 'x' type invariant] inv_refmut_Once_T x)
    /\ ([@stop_split] [@expl:uses_invariant requires] invariant_Once_T x.current)}
    (! bb0
    [ bb0 = s0
      [ s0 = MutBorrow.borrow_final <t_Option_T> {x.current.f0} {MutBorrow.inherit_id (MutBorrow.get_id x) 0}
          (fun (_bor: MutBorrow.t t_Option_T) ->
            [ &_7 <- _bor ] -{inv_Option_T _bor.final}-
            [ &x <- { x with current = { f0 = _bor.final } } ] s1)
        [ _ck -> (! {[@expl:type invariant] inv_Option_T x.current.f0} any) ]
      | s1 = take_T {_7} (fun (_x: t_Option_T) -> [ &_6 <- _x ] s2)
      | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_Option_T _6} any) ]
      | s3 = -{resolve_Option_T _6}- s4
      | s4 = s5 [ _ck -> (! {[@expl:type invariant] inv_refmut_Once_T x} any) ]
      | s5 = -{resolve_refmut_Once_T x}- s6
      | s6 = return {_ret} ] ]
    [ & _ret: () = Any.any_l ()
    | & x: MutBorrow.t t_Once_T = x
    | & _6: t_Option_T = Any.any_l ()
    | & _7: MutBorrow.t t_Option_T = Any.any_l () ])
    [ return (result: ()) -> {[@stop_split] [@expl:uses_invariant ensures] invariant_Once_T x.final}
      (! return {result}) ]
end
