module M_test
  use creusot.prelude.Any
  
  constant transparent: bool = true
  
  constant transparent_crate: bool = true
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let test (return (x: ())) = (! bb0
    [ bb0 = s0
      [ s0 = {[@expl:assertion] transparent} s1 | s1 = {[@expl:assertion] transparent_crate} s2 | s2 = return {_ret} ] ]
    [ & _ret: () = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
end
