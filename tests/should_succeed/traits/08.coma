module M_test
  use creusot.prelude.Any
  
  type t_T
  
  function inv_T (_1: t_T) : bool
  
  function resolve_T (_1: t_T) : bool
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let test_T (_1: t_T) (return (x: ())) = {[@stop_split] [@expl:test '_1' type invariant] inv_T _1}
    (! bb0
    [ bb0 = s0
      [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_T _1} any) ] | s1 = -{resolve_T _1}- s2 | s2 = return {_ret} ] ]
    [ & _ret: () = Any.any_l () | & _1: t_T = _1 ]) [ return (result: ()) -> (! return {result}) ]
end
module M_trait_Tr__program
  use creusot.prelude.Any
  
  type t_Self
  
  function inv_Self (_1: t_Self) : bool
  
  function invariant_ref_Self [@inline:trivial] (self: t_Self) : bool = inv_Self self
  
  meta "rewrite_def" function invariant_ref_Self
  
  function inv_ref_Self [@inline:trivial] (_1: t_Self) : bool = invariant_ref_Self _1
  
  meta "rewrite_def" function inv_ref_Self
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let program_Self (self: t_Self) (return (x: ())) =
  {[@stop_split] [@expl:program 'self' type invariant] inv_ref_Self self}
    (! bb0
    [ bb0 = return {_ret} ] [ & _ret: () = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
end
