module M_test
  use creusot.prelude.MutBorrow
  use seq.Seq
  use creusot.int.UInt64
  use creusot.prelude.Any
  use int.Int
  
  type t_Vec_T_Global
  
  type t_Vec_T = { f0: t_Vec_T_Global }
  
  type t_T
  
  function inv_T (_1: t_T) : bool
  
  function invariant_ref_T [@inline:trivial] (self: t_T) : bool = inv_T self
  
  meta "rewrite_def" function invariant_ref_T
  
  function inv_ref_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_T _1
  
  meta "rewrite_def" function inv_ref_T
  
  function invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) : bool = forall i: int. 0 <= i /\ i < Seq.length self
      -> inv_ref_T (Seq.get self i)
  
  meta "rewrite_def" function invariant_Seq_T
  
  function inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) : bool = invariant_Seq_T _1
  
  meta "rewrite_def" function inv_Seq_T
  
  constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)
  
  function view_Vec_T_Global (self: t_Vec_T_Global) : Seq.seq t_T
  
  axiom view_Vec_T_Global_spec:
    forall self: t_Vec_T_Global [view_Vec_T_Global self]. Seq.length (view_Vec_T_Global self) <= UInt64.t'int const_MAX
  
  function invariant_Vec_T_Global (self: t_Vec_T_Global) : bool = inv_Seq_T (view_Vec_T_Global self)
  
  function inv_Vec_T_Global (_1: t_Vec_T_Global) : bool
  
  axiom inv_axiom: forall _1: t_Vec_T_Global [inv_Vec_T_Global _1]. inv_Vec_T_Global _1 -> invariant_Vec_T_Global _1
  
  function inv_Vec_T (_1: t_Vec_T) : bool
  
  axiom inv_axiom'0 [@rewrite]: forall _1: t_Vec_T [inv_Vec_T _1]. inv_Vec_T _1 = inv_Vec_T_Global _1.f0
  
  function invariant_refmut_Vec_T [@inline:trivial] (self: MutBorrow.t t_Vec_T) : bool = inv_Vec_T self.current
    /\ inv_Vec_T self.final
  
  meta "rewrite_def" function invariant_refmut_Vec_T
  
  function inv_refmut_Vec_T [@inline:trivial] (_1: MutBorrow.t t_Vec_T) : bool = invariant_refmut_Vec_T _1
  
  meta "rewrite_def" function inv_refmut_Vec_T
  
  function resolve_refmut_Vec_T [@inline:trivial] (_1: MutBorrow.t t_Vec_T) : bool = _1.final = _1.current
  
  meta "rewrite_def" function resolve_refmut_Vec_T
  
  function view_Vec_T (self: t_Vec_T) : Seq.seq t_T
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let test_T (x: MutBorrow.t t_Vec_T) (return (x'0: ())) =
  {[@stop_split] [@expl:test 'x' type invariant] inv_refmut_Vec_T x}
    (! bb0
    [ bb0 = s0
      [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_refmut_Vec_T x} any) ]
      | s1 = -{resolve_refmut_Vec_T x}- s2
      | s2 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & x: MutBorrow.t t_Vec_T = x ])
    [ return (result: ()) -> {[@stop_split] [@expl:test ensures] view_Vec_T x.current = view_Vec_T x.current}
      (! return {result}) ]
end
