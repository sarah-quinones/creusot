module M_uses_generic
  use creusot.int.UInt32
  use creusot.prelude.Any
  
  type t_T
  
  function inv_T (_1: t_T) : bool
  
  function precondition_from_b (self: ()) (args: t_T) : bool
  
  axiom precondition_fndef: forall args: t_T [precondition_from_b () args]. (let x = args in inv_T x)
      -> precondition_from_b () args
  
  function postcondition_from_b (self: ()) (args: t_T) (result: UInt32.t) : bool
  
  axiom postcondition_fndef:
    forall args: t_T, result: UInt32.t [postcondition_from_b () args result]. postcondition_from_b () args result
      -> (let x = args in true)
  
  function postcondition_once_from_b (self: ()) (args: t_T) (result: UInt32.t) : bool =
    postcondition_from_b self args result
  
  meta "rewrite_def" function postcondition_once_from_b
  
  let from_b_T (x: t_T) (return (x'0: UInt32.t)) = {[@stop_split] [@expl:from_b requires] precondition_from_b () x}
    any
    [ return (result: UInt32.t) -> {[@stop_split] [@expl:from_b ensures] postcondition_once_from_b () x result}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let uses_generic_T (b: t_T) (return (x: UInt32.t)) = {[@stop_split] [@expl:uses_generic 'b' type invariant] inv_T b}
    (! bb0
    [ bb0 = s0 [ s0 = from_b_T {b} (fun (_x: UInt32.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
    [ & _ret: UInt32.t = Any.any_l () | & b: t_T = b ]) [ return (result: UInt32.t) -> (! return {result}) ]
end
