module M_impl_Model_for_ref_T__model (* <&T as Model> *)
  use creusot.prelude.Any
  
  type t_T
  
  type t_ModelTy
  
  function inv_T (_1: t_T) : bool
  
  function invariant_ref_T [@inline:trivial] (self: t_T) : bool = inv_T self
  
  meta "rewrite_def" function invariant_ref_T
  
  function inv_ref_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_T _1
  
  meta "rewrite_def" function inv_ref_T
  
  function inv_ModelTy (_1: t_ModelTy) : bool
  
  let model_ref_T (self: t_T) (return (x: t_ModelTy)) =
  {[@stop_split] [@expl:model 'self' type invariant] inv_ref_T self}
    any
    [ return (result: t_ModelTy) -> {[@stop_split] [@expl:model result type invariant] inv_ModelTy result}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let model_ref_T'0 (self: t_T) (return (x: t_ModelTy)) =
  {[@stop_split] [@expl:model 'self' type invariant] inv_ref_T self}
    (! bb0
    [ bb0 = s0 [ s0 = model_ref_T {self} (fun (_x: t_ModelTy) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
    [ & _ret: t_ModelTy = Any.any_l () | & self: t_T = self ])
    [ return (result: t_ModelTy) -> {[@stop_split] [@expl:model result type invariant] inv_ModelTy result}
      (! return {result}) ]
end
module M_impl_Model_for_ref_T__model__refines (* <&T as Model> *)
  type t_T
  
  function inv_T (_1: t_T) : bool
  
  function invariant_ref_T [@inline:trivial] (self: t_T) : bool = inv_T self
  
  meta "rewrite_def" function invariant_ref_T
  
  function inv_ref_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_T _1
  
  meta "rewrite_def" function inv_ref_T
  
  type t_ModelTy
  
  function inv_ModelTy (_1: t_ModelTy) : bool
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  goal refines: forall self: t_T. inv_ref_T self
      -> inv_ref_T self /\ (forall result: t_ModelTy. inv_ModelTy result -> inv_ModelTy result)
end
