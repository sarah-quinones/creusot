module M_multi_use
  use creusot.int.UInt32
  use creusot.prelude.Any
  
  type t_T
  
  type closure0 = { c0: t_T }
  
  function inv_T (_1: t_T) : bool
  
  function invariant_ref_T [@inline:trivial] (self: t_T) : bool = inv_T self
  
  meta "rewrite_def" function invariant_ref_T
  
  function inv_ref_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_T _1
  
  meta "rewrite_def" function inv_ref_T
  
  function invariant_ref_ref_T [@inline:trivial] (self: t_T) : bool = inv_ref_T self
  
  meta "rewrite_def" function invariant_ref_ref_T
  
  function inv_ref_ref_T [@inline:trivial] (_1: t_T) : bool = invariant_ref_ref_T _1
  
  meta "rewrite_def" function inv_ref_ref_T
  
  function inv_closure0 [@inline:trivial] (_1: closure0) : bool = let {c0 = x0} = _1 in inv_ref_ref_T x0
  
  meta "rewrite_def" function inv_closure0
  
  function invariant_ref_closure0 [@inline:trivial] (self: closure0) : bool = inv_closure0 self
  
  meta "rewrite_def" function invariant_ref_closure0
  
  function inv_ref_closure0 [@inline:trivial] (_1: closure0) : bool = invariant_ref_closure0 _1
  
  meta "rewrite_def" function inv_ref_closure0
  
  let closure0 (self: closure0) (return (x: UInt32.t)) =
  {[@stop_split] [@expl:closure0 requires] ([@stop_split] [@expl:closure 'self' type invariant] inv_ref_closure0 self)
    /\ ([@stop_split] [@expl:closure requires] self.c0 = self.c0)}
    (! bb0
    [ bb0 = s0 [ s0 = [ &res <- (0: UInt32.t) ] s1 | s1 = [ &_ret <- res ] s2 | s2 = return {_ret} ] ]
    [ & _ret: UInt32.t = Any.any_l () | & res: UInt32.t = Any.any_l () ])
    [ return (result: UInt32.t) -> (! return {result}) ]
  
  function precondition_closure0 (self: closure0) (args: ()) : bool = self.c0 = self.c0
  
  meta "rewrite_def" function precondition_closure0
  
  function postcondition_closure0 (self: closure0) (args: ()) (result: UInt32.t) : bool = true
  
  meta "rewrite_def" function postcondition_closure0
  
  function postcondition_ref_closure0 (self: closure0) (args: ()) (result: UInt32.t) : bool =
    postcondition_closure0 self args result
  
  meta "rewrite_def" function postcondition_ref_closure0
  
  let uses_fn_closure0 (f: closure0) (return (x: ())) =
  {[@stop_split] [@expl:uses_fn_closure0 requires] ([@stop_split] [@expl:uses_fn 'f' type invariant] inv_closure0 f)
    /\ ([@stop_split] [@expl:uses_fn requires] precondition_closure0 f ())}
    any
    [ return (result: ()) -> {[@stop_split] [@expl:uses_fn ensures] exists f2: closure0, r: UInt32.t. f2 = f
        /\ postcondition_ref_closure0 f2 () r}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let multi_use_T (x: t_T) (return (x'0: ())) = {[@stop_split] [@expl:multi_use 'x' type invariant] inv_ref_T x}
    (! bb0
    [ bb0 = s0
      [ s0 = [ &c <- { c0 = x } ] s1
      | s1 = uses_fn_closure0 {c} (fun (_x: ()) -> [ &_4 <- _x ] s2)
      | s2 = return {_ret} ] ]
    [ & _ret: () = Any.any_l () | & x: t_T = x | & c: closure0 = Any.any_l () | & _4: () = Any.any_l () ])
    [ return (result: ()) -> (! return {result}) ]
end
