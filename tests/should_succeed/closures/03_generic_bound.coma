module M_caller
  use creusot.prelude.Any
  use creusot.int.UInt32
  
  let closure0 [@coma:extspec] (self: ()) (_x: UInt32.t) (return (x: ())) = bb0
    [ bb0 = return {_ret} ] [ & _ret: () = Any.any_l () ] [ return (result: ()) -> return {result} ]
  
  meta "rewrite_def" predicate closure0'pre
  
  meta "rewrite_def" predicate closure0'post'return
  
  let closure_param_closure0 (f: ()) (return (x: ())) = any [ return (result: ()) -> (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let caller (return (x: ())) = (! bb0
    [ bb0 = s0
      [ s0 = [ &_1 <- () ] s1
      | s1 = closure_param_closure0 {_1} (fun (_x: ()) -> [ &_ret <- _x ] s2)
      | s2 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & _1: () = Any.any_l () ])
    [ return (result: ()) -> (! return {result}) ]
end
module M_closure_param
  use creusot.int.UInt32
  use creusot.prelude.Any
  
  type t_F
  
  function inv_F (_1: t_F) : bool
  
  function resolve_F (_1: t_F) : bool
  
  function invariant_ref_F [@inline:trivial] (self: t_F) : bool = inv_F self
  
  meta "rewrite_def" function invariant_ref_F
  
  function inv_ref_F [@inline:trivial] (_1: t_F) : bool = invariant_ref_F _1
  
  meta "rewrite_def" function inv_ref_F
  
  function precondition_F (self: t_F) (args: UInt32.t) : bool
  
  function postcondition_once_F (self: t_F) (args: UInt32.t) (result: ()) : bool
  
  function postcondition_mut_F (self: t_F) (args: UInt32.t) (result_state: t_F) (result: ()) : bool
  
  function fn_mut_once_F (self: t_F) (args: UInt32.t) (res: ()) : ()
  
  axiom fn_mut_once_F_spec:
    forall self: t_F, args: UInt32.t, res: () [postcondition_once_F self args res]. postcondition_once_F self args res
      = (exists res_state: t_F. postcondition_mut_F self args res_state res /\ resolve_F res_state)
  
  function hist_inv_F (self: t_F) (result_state: t_F) : bool
  
  function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()
  
  axiom hist_inv_trans_F_spec:
    forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
      -> hist_inv_F b c -> hist_inv_F self c
  
  function hist_inv_refl_F (self: t_F) : ()
  
  axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self
  
  function postcondition_mut_hist_inv_F (self: t_F) (args: UInt32.t) (res_state: t_F) (res: ()) : ()
  
  axiom postcondition_mut_hist_inv_F_spec:
    forall self: t_F, args: UInt32.t, res_state: t_F, res: () [postcondition_mut_F self args res_state res | hist_inv_F self res_state]. postcondition_mut_F self args res_state res
      -> hist_inv_F self res_state
  
  function fn_hist_inv_F (self: t_F) (res_state: t_F) : ()
  
  axiom fn_hist_inv_F_spec: forall self: t_F, res_state: t_F [hist_inv_F self res_state]. hist_inv_F self res_state
      = (self = res_state)
  
  function postcondition_F (self: t_F) (args: UInt32.t) (result: ()) : bool
  
  function fn_once_F (self: t_F) (args: UInt32.t) (res: ()) : ()
  
  axiom fn_once_F_spec:
    forall self: t_F, args: UInt32.t, res: () [postcondition_once_F self args res]. postcondition_once_F self args res
      = (postcondition_F self args res /\ resolve_F self)
  
  function fn_mut_F (self: t_F) (args: UInt32.t) (res_state: t_F) (res: ()) : ()
  
  axiom fn_mut_F_spec:
    forall self: t_F, args: UInt32.t, res_state: t_F, res: () [postcondition_mut_F self args res_state res]. postcondition_mut_F self args res_state res
      = (postcondition_F self args res /\ self = res_state)
  
  let call_F (self: t_F) (args: UInt32.t) (return (x: ())) =
  {[@stop_split] [@expl:call_F requires] ([@stop_split] [@expl:call 'self' type invariant] inv_ref_F self)
    /\ ([@stop_split] [@expl:call requires] precondition_F self args)}
    any
    [ return (result: ()) -> {[@stop_split] [@expl:call ensures] postcondition_F self args result} (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let closure_param_F (f: t_F) (return (x: ())) = {[@stop_split] [@expl:closure_param 'f' type invariant] inv_F f}
    (! bb0
    [ bb0 = s0
      [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_F f} any) ]
      | s1 = -{resolve_F f}- s2
      | s2 = [ &_3 <- (0: UInt32.t) ] s3
      | s3 = call_F {f} {_3} (fun (_x: ()) -> [ &_ret <- _x ] s4)
      | s4 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & f: t_F = f | & _3: UInt32.t = Any.any_l () ])
    [ return (result: ()) -> (! return {result}) ]
end
