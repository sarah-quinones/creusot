module M_id
  type t_T
  
  predicate const_true_T (_1: t_T)
  
  axiom const_true_T_def: forall _1: t_T [const_true_T _1]. const_true_T _1 = true
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant x : t_T
  
  function id_T (x: t_T) : t_T
  
  goal vc_id_T: [@stop_split] [@expl:id ensures] const_true_T x
end
module M_test
  use map.Map
  use int.Int
  
  function f (_1: int) : int
  
  function f_def (x: int) : ()
  
  axiom f_def_spec: forall x: int [f_def x]. f (2 * x + 1) = f (2 * x - 1)
  
  function index_Mapping_Int_unit [@inline:trivial] (self: Map.map int ()) (a: int) : () = Map.get self a
  
  meta "rewrite_def" function index_Mapping_Int_unit
  
  predicate const_true_unit (_1: ())
  
  axiom const_true_unit_def: forall _1: () [const_true_unit _1]. const_true_unit _1 = true
  
  function id_unit (x: ()) : ()
  
  axiom id_unit_def: forall x: () [id_unit x]. id_unit x = x
  
  axiom id_unit_spec: forall x: (). const_true_unit x
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  function test : ()
  
  goal vc_test: forall f'0: Map.map int (). (forall _0: int [Map.get f'0 _0]. () = Map.get f'0 _0)
      -> (forall t. t = f'0
        -> (let t = t in (forall i: int. ([@stop_split] [@expl:f_def ensures] f (2 * 2 * i + 1) = f (2 * 2 * i - 1))
            -> (forall local. local = f_def (2 * i)
              -> ([@stop_split] [@expl:f_def ensures] f (2 * (2 * i + 1) + 1) = f (2 * (2 * i + 1) - 1))
              -> (forall local'0. local'0 = f_def (2 * i + 1) -> true)))
        /\ (forall f'1: Map.map int (). (forall i: int [index_Mapping_Int_unit t i | Map.get f'1 i]. ([@stop_split] [@expl:f_def ensures] f (2
                      * 2
                    * i
                  + 1)
                = f (2 * 2 * i - 1))
              /\ (exists local. local = f_def (2 * i)
                /\ ([@stop_split] [@expl:f_def ensures] f (2 * (2 * i + 1) + 1) = f (2 * (2 * i + 1) - 1))
                /\ (exists local'0. local'0 = f_def (2 * i + 1) /\ () = Map.get f'1 i)))
          -> (forall local. local = f'1
            -> ([@stop_split] [@expl:id ensures] const_true_unit (index_Mapping_Int_unit t 0))
            -> (forall local'0. local'0 = id_unit (index_Mapping_Int_unit t 0)
              -> ([@stop_split] [@expl:id ensures] const_true_unit (index_Mapping_Int_unit t 1))
              -> (forall local'1. local'1 = id_unit (index_Mapping_Int_unit t 1)
                -> ([@stop_split] [@expl:id ensures] const_true_unit (index_Mapping_Int_unit t 2))
                -> (forall local'2. local'2 = id_unit (index_Mapping_Int_unit t 2)
                  -> ([@stop_split] [@expl:id ensures] const_true_unit (index_Mapping_Int_unit t 3))
                  -> (forall local'3. local'3 = id_unit (index_Mapping_Int_unit t 3)
                    -> ([@stop_split] [@expl:id ensures] const_true_unit (index_Mapping_Int_unit t 4))
                    -> (forall local'4. local'4 = id_unit (index_Mapping_Int_unit t 4)
                      -> ([@stop_split] [@expl:id ensures] const_true_unit (index_Mapping_Int_unit t 5))
                      -> (forall local'5. local'5 = id_unit (index_Mapping_Int_unit t 5)
                        -> f 23 = f (- 1)
                        && (forall local'6. local'6 = () -> (forall local'7. local'7 = () -> true))))))))))))
end
