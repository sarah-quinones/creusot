module M_f
  type t_Option_Int = None | Some int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant x : t_Option_Int
  
  constant y : t_Option_Int
  
  function f (x: t_Option_Int) (y: t_Option_Int) : bool
  
  goal vc_f: [@stop_split] [@expl:f ensures] (x <> y) = (not x = y)
end
